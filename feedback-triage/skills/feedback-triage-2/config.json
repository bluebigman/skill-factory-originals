   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "去重合并",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "优先级",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "闭环回复",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "趋势观察",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
