{
 "name": "content-moderation-1",
 "version": "2.0.0",
 "domain": "内容审核",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "先定红线",
   "then": "先明确不可触碰的红线清单",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "双人复核",
   "then": "高风险内容双人复核",
   "source": "scripts/main.py#RULES[1]"
  }
 ],
 "keywords": [
  {
   "term": "先定红线",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "双人复核",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [
  {
   "term": "风险",
   "source": "scripts/main.py#RULES.then"
  }
 ],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}