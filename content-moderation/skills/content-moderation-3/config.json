{
 "name": "content-moderation-3",
 "version": "2.0.0",
 "domain": "内容审核",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "定期更新",
   "then": "红线清单随法规变化更新",
   "source": "scripts/main.py#RULES[0]"
  }
 ],
 "keywords": [
  {
   "term": "定期更新",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [
  {
   "term": "先定",
   "source": "SKILL.md#L3"
  },
  {
   "term": "风险",
   "source": "SKILL.md#L58"
  },
  {
   "term": "变化",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "复核",
   "source": "SKILL.md#L3"
  }
 ],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}