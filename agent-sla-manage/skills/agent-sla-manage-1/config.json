{
 "name": "agent-sla-manage-1",
 "version": "2.0.0",
 "domain": "服务标准",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "时限明确",
   "then": "明确响应与完成时限",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "分级标准",
   "then": "按重要性分级",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "违约处理",
   "then": "超时须有处理",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "度量可测",
   "then": "履约情况可度量",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "改进闭环",
   "then": "违约须复盘",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "时限明确",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "分级标准",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "违约处理",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "度量可测",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "改进闭环",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}