{
 "name": "mp-article-format-1",
 "version": "2.0.0",
 "domain": "公众号文章",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "留白优先",
   "then": "段间距大于行距，阅读更顺",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "三段一图",
   "then": "每 3 段插一张图或一个分隔",
   "source": "scripts/main.py#RULES[1]"
  }
 ],
 "keywords": [
  {
   "term": "留白优先",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "三段一图",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [
  {
   "term": "助手",
   "source": "SKILL.md#L11"
  },
  {
   "term": "阅读",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "公众号",
   "source": "SKILL.md#L11"
  },
  {
   "term": "排版",
   "source": "SKILL.md#L11"
  }
 ],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}