{
 "name": "settle-in",
 "version": "2.0.0",
 "domain": "搬家",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "找不到东西",
   "then": "先建临时归位区并记录，全部就位再精修布局",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "生活不便",
   "then": "第一周优先解决睡眠、洗浴、做饭三件事",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "周边不熟",
