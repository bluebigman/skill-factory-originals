{
 "name": "move-plan",
 "version": "2.0.0",
 "domain": "搬家",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "打包混乱",
   "then": "按开放顺序倒序打包（最后用的先装），并标注房间+内容",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "物品丢失",
   "then": "贵重与证件单独随身，绝不进搬家车",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "时间不够",
   "then": "提前 4 周开始，仅处理低频物品，最后一周只封高频",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "费用超支",
   "then": "先确定计费方式（按车/按小时/按楼层），口头报价必加价",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "新居不适",
   "then": "入住前完成水电燃气网络开通，当天办必影响入住",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
