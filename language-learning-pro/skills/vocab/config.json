{
 "name": "vocab",
 "version": "2.0.0",
 "domain": "语言学习",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "只背词表",
   "then": "词表脱离语境，须在句子与场景中记",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "不复习",
   "then": "按间隔重复安排复习（1天/3天/7天/30天）",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "追求数量",
   "then": "以能用为标准，能用的 1000 词胜过认得的 10000 词",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "只看不读",
   "then": "配合发音记忆，多感官编码提升留存",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "无输出",
   "then": "每记一个新词即造一个句子",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
