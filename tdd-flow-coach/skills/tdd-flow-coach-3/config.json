{
 "name": "tdd-flow-coach-3",
 "version": "2.0.0",
 "domain": "测试驱动开发",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "先写失败用例",
   "then": "未见过红灯不写实现",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "一次一断言",
   "then": "单测只验一件事",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "最小实现",
   "then": "先写能过的最简代码再重构",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "重构不留新功能",
   "then": "重构与加功能分两次提交",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "测试可读",
   "then": "用例名描述行为而非实现",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "先写失败用例",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "一次一断言",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "最小实现",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "重构不留新功能",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "测试可读",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}