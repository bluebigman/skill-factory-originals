{
 "name": "pdf-to-md-3",
 "version": "2.0.0",
 "domain": "文档PDF",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "抽样校验",
   "then": "随机抽 3 页与原文件逐字比对",
   "source": "scripts/main.py#RULES[0]"
  }
 ],
 "keywords": [
  {
   "term": "抽样校验",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [
  {
   "term": "优先",
   "source": "SKILL.md#L3"
  },
  {
   "term": "助手",
   "source": "SKILL.md#L11"
  },
  {
   "term": "表格",
   "source": "SKILL.md#L3"
  },
  {
   "term": "文档",
   "source": "SKILL.md#L11"
  }
 ],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}