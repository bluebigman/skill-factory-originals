{
 "name": "doc-localization-pro-3",
 "version": "2.0.0",
 "domain": "文档本地",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "术语表",
   "then": "先建术语对照表",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "语境适配",
   "then": "不只直译要适配",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "格式保留",
   "then": "保留原格式",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "文化适配",
   "then": "注意文化差异",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "母语复核",
   "then": "目标语母语者复核",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "术语表",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "语境适配",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "格式保留",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "文化适配",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "母语复核",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}