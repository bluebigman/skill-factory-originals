{
 "name": "dashboard-perf-2",
 "version": "2.0.0",
 "domain": "仪表盘性能",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "预聚合",
   "then": "高频查询走汇总表",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "按需加载",
   "then": "首屏只加载核心图",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "缓存分层",
   "then": "静态与动态分别缓存",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "查询收敛",
   "then": "限制单次查询范围",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "监控耗时",
   "then": "记录每图加载耗时",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "预聚合",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "按需加载",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "缓存分层",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "查询收敛",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "监控耗时",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}