{
 "name": "kit-prep",
 "version": "2.0.0",
 "domain": "家庭急救",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "物资缺失",
   "then": "基础箱：创可贴/纱布/消毒液/绷带/体温计/手套/剪刀",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "过期未查",
   "then": "每半年检查一次有效期并补齐，过期物资等于没有",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "位置不便",
   "then": "急救箱放固定且全家知晓的位置，分散存放等于没有",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "知识空白",
   "then": "家庭成员至少一人完成正规急救培训",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "信息卡",
   "then": "冰箱贴留存紧急联系人、过敏史与常用药清单",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
