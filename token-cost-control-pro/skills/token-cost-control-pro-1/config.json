{
 "name": "token-cost-control-pro-1",
 "version": "2.0.0",
 "domain": "成本控制",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "预算预设",
   "then": "每任务预设 token 预算",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "迭代上限",
   "then": "设最大迭代次数",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "片段回灌",
   "then": "只回灌相关片段不重投全文",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "历史压缩",
   "then": "长会话压缩保留结论",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "前缀缓存",
   "then": "稳定前缀做缓存复用",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "预算预设",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "迭代上限",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "片段回灌",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "历史压缩",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "前缀缓存",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}