{
 "name": "data-lineage-3",
 "version": "2.0.0",
 "domain": "数据血缘梳理",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "从消费端反推",
   "then": "从报表反推到源",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "节点粒度",
   "then": "表与字段级血缘",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "变更影响",
   "then": "变更前评估下游影响面",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "自动化采集",
   "then": "尽可能从元数据自动生成",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "定期更新",
   "then": "结构变更后同步",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "从消费端反推",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "节点粒度",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "变更影响",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "自动化采集",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "定期更新",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}