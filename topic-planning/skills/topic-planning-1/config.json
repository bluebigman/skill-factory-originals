{
 "name": "topic-planning-1",
 "version": "2.0.0",
 "domain": "内容选题",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "从问题找",
   "then": "从用户真实提问里找选题，比凭空想强",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "验证需求",
   "then": "先搜一下有多少人问过同类问题",
   "source": "scripts/main.py#RULES[1]"
  }
 ],
 "keywords": [
  {
   "term": "从问题找",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "验证需求",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [
  {
   "term": "助手",
   "source": "SKILL.md#L11"
  },
  {
   "term": "同类",
   "source": "scripts/main.py#RULES.then"
  }
 ],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}