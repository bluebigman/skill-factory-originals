{
 "name": "selling-point",
 "version": "2.0.0",
 "domain": "商品详情",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "自说自话",
   "then": "卖点须对应买家痛点，而非产品功能罗列",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "无差异化",
   "then": "与竞品对比找出唯一差异点并放大",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "排序混乱",
   "then": "按买家决策顺序排：第一眼最关心的放最前",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "无证据",
   "then": "每个卖点配证据（参数/认证/实测/口碑）",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "卖点过多",
