{
 "name": "project-milestone-3",
 "version": "2.0.0",
 "domain": "里程碑管理",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "里程碑明确",
   "then": "定义可验证里程碑",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "依赖梳理",
   "then": "理清前置依赖",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "风险前置",
   "then": "提前识别风险",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "进度可见",
   "then": "进度透明",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "偏差处理",
   "then": "偏差即调整",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "里程碑明确",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "依赖梳理",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "风险前置",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "进度可见",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "偏差处理",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}