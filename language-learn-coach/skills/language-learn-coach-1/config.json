  },
  {
   "term": "最高",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "学习",
   "source": "SKILL.md#L11"
  },
  {
   "term": "再谈",
   "source": "scripts/main.py#RULES.then"
  },
  {
