{
 "name": "email-professional-3",
 "version": "2.0.0",
 "domain": "商务邮件撰写",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "主题具体",
   "then": "主题含事项与时限",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "首句给目的",
   "then": "不寒暄直接说事",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "一段一事",
   "then": "多事项分段落或分邮件",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "行动明确",
   "then": "写清期望对方做什么何时做",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "附件提及",
   "then": "正文说明附件内容",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "主题具体",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "首句给目的",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "一段一事",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "行动明确",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "附件提及",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}