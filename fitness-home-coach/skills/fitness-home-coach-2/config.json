{
 "name": "fitness-home-coach-2",
 "version": "2.0.0",
 "domain": "居家健身",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "训练频率",
   "then": "同肌群间隔 48 小时",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "动作优先",
   "then": "宁轻勿假",
   "source": "scripts/main.py#RULES[1]"
  }
 ],
 "keywords": [
  {
   "term": "训练频率",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "动作优先",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [
  {
   "term": "小时",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "方案",
   "source": "SKILL.md#L3"
  },
  {
   "term": "计划",
   "source": "SKILL.md#L11"
  },
  {
   "term": "渐进",
   "source": "SKILL.md#L3"
  },
  {
   "term": "居家",
   "source": "SKILL.md#L11"
  },
  {
   "term": "间隔",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "负荷",
   "source": "SKILL.md#L3"
  },
  {
   "term": "健身",
   "source": "SKILL.md#L11"
  }
 ],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}