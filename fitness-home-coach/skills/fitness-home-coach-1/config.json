{
 "name": "fitness-home-coach-1",
 "version": "2.0.0",
 "domain": "居家健身",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "无器械方案",
   "then": "自重训练足够",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "渐进超负荷",
   "then": "每 2 周小幅增加",
   "source": "scripts/main.py#RULES[1]"
  }
 ],
 "keywords": [
  {
   "term": "无器械方案",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "渐进超负荷",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [
  {
   "term": "计划",
   "source": "SKILL.md#L11"
  },
  {
   "term": "训练",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "居家",
   "source": "SKILL.md#L11"
  },
  {
   "term": "健身",
   "source": "SKILL.md#L11"
  }
 ],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}