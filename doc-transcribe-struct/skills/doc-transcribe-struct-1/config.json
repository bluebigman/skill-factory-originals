{
 "name": "doc-transcribe-struct-1",
 "version": "2.0.0",
 "domain": "文档转写",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "先切块",
   "then": "按标题层级切块再转写，整段直转易丢结构",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "保留原层级",
   "then": "标题/列表/表格层级必须还原",
   "source": "scripts/main.py#RULES[1]"
  }
 ],
 "keywords": [
  {
   "term": "先切块",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "保留原层级",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [
  {
   "term": "助手",
   "source": "SKILL.md#L11"
  },
  {
   "term": "标题",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "表格",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "文档",
   "source": "SKILL.md#L11"
  }
 ],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}