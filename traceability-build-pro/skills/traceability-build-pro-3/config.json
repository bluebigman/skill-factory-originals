{
 "name": "traceability-build-pro-3",
 "version": "2.0.0",
 "domain": "追溯体系",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "演练验证",
   "then": "定期做追溯与召回演练",
   "source": "scripts/main.py#RULES[0]"
  }
 ],
 "keywords": [
  {
   "term": "演练验证",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [
  {
   "term": "定期",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "管理",
   "source": "SKILL.md#L11"
  },
  {
   "term": "追溯",
   "source": "scripts/main.py#RULES.then"
  }
 ],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}