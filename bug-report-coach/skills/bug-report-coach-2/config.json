{
 "name": "bug-report-coach-2",
 "version": "2.0.0",
 "domain": "缺陷报告",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "单一现象",
   "then": "一单只报一个现象，便于跟踪",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "附证据",
   "then": "日志、截图、时间点齐全",
   "source": "scripts/main.py#RULES[1]"
  }
 ],
 "keywords": [
  {
   "term": "单一现象",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "附证据",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [
  {
   "term": "时间",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "优先",
   "source": "SKILL.md#L3"
  },
  {
   "term": "助手",
   "source": "SKILL.md#L11"
  },
  {
   "term": "版本",
   "source": "SKILL.md#L58"
  },
  {
   "term": "稳定",
   "source": "SKILL.md#L57"
  },
  {
   "term": "间点",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "报告",
   "source": "SKILL.md#L11"
  },
  {
   "term": "跟踪",
   "source": "scripts/main.py#RULES.then"
  }
 ],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}