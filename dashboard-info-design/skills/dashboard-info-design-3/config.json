{
 "name": "dashboard-info-design-3",
 "version": "2.0.0",
 "domain": "信息看板设计",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "核心先行",
   "then": "首屏核心指标",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "对比基线",
   "then": "每指标配对比",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "分层布局",
   "then": "概览-趋势-明细",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "异常突出",
   "then": "异常自动凸显",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "下钻可达",
   "then": "支持下钻",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "核心先行",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "对比基线",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "分层布局",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "异常突出",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "下钻可达",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}