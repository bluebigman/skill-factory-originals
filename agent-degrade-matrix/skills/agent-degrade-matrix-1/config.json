{
 "name": "agent-degrade-matrix-1",
 "version": "2.0.0",
 "domain": "降级矩阵",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "分级明确",
   "then": "定义降级级别",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "能力声明",
   "then": "每级声明剩余能力",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "触发条件",
   "then": "明确触发条件",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "用户可知",
   "then": "降级须告知用户",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "恢复自动",
   "then": "恢复后自动切回",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "分级明确",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "能力声明",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "触发条件",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "用户可知",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "恢复自动",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}