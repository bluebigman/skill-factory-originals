{
 "name": "direction",
 "version": "2.0.0",
 "domain": "转行规划",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "凭兴趣转",
   "then": "先做 20 小时真实任务再决定，兴趣与职业现实差距极大",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "一步到位",
   "then": "优先平移（行业换岗位不换 或 岗位换行业不换），双换成功率低",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "信息不足",
   "then": "找 3 位目标岗位从业者做信息访谈，二手信息不可信",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "沉没成本",
   "then": "不因已投入年限而拒绝转向，已投入无法回收",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "周期预期",
   "then": "转行准备期按 6-12 个月规划，短期速成预期会导致中途放弃",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
