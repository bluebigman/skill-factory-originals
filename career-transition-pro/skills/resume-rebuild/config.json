{
 "name": "resume-rebuild",
 "version": "2.0.0",
 "domain": "转行规划",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "经历不对口",
   "then": "把旧经历翻译为目标岗位语言（问题-动作-结果）",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "无相关经验",
   "then": "用项目/兼职/开源/证书补证据，空口无凭无法说服",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "堆砌职责",
   "then": "写成果不写职责，「负责XX」无信息量",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "篇幅过长",
   "then": "控制在 2 页内，早期经历压缩为一行",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "技能栏空洞",
   "then": "技能须可验证（作品链接/项目链接），列名词无意义",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
