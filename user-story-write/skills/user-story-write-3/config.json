{
 "name": "user-story-write-3",
 "version": "2.0.0",
 "domain": "用户故事",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "角色明确",
   "then": "写明作为什么角色",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "价值明确",
   "then": "写清想达成什么",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "验收条件",
   "then": "配可验证的验收项",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "粒度适中",
   "then": "一个迭代内可完成",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "避免技术描述",
   "then": "描述需求描述",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "角色明确",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "价值明确",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "验收条件",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "粒度适中",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "避免技术描述",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}