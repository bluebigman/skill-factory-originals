{
 "name": "schema-doc-pro-1",
 "version": "2.0.0",
 "domain": "表结构文",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "字段完整",
   "then": "字段名类型含义齐全",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "口径记录",
   "then": "统计口径写明",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "负责人",
   "then": "每表有负责人",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "变更同步",
   "then": "结构变更同步更新",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "血缘关联",
   "then": "关联上下游",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "字段完整",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "口径记录",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "负责人",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "变更同步",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "血缘关联",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}