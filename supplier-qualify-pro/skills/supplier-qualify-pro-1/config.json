{
 "name": "supplier-qualify-pro-1",
 "version": "2.0.0",
 "domain": "供应商",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "分级准入",
   "then": "按物料关键度分级，关键料从严",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "现场审核",
   "then": "关键供应商必须现场审核并留报告",
   "source": "scripts/main.py#RULES[1]"
  }
 ],
 "keywords": [
  {
   "term": "分级准入",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "现场审核",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [
  {
   "term": "评估",
   "source": "SKILL.md#L11"
  },
  {
   "term": "度分",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "报告",
   "source": "scripts/main.py#RULES.then"
  }
 ],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}