{
 "name": "data-retention-policy-1",
 "version": "2.0.0",
 "domain": "数据保留",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "分级保留",
   "then": "按数据级别定保留期",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "合规优先",
   "then": "满足法规要求",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "清理可逆",
   "then": "清理前留归档",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "自动执行",
   "then": "到期自动清理",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "留痕",
   "then": "清理过程留痕",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "分级保留",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "合规优先",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "清理可逆",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "自动执行",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "留痕",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}