{
 "name": "self-assess",
 "version": "2.0.0",
 "domain": "职业规划",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "自我评估失真",
   "then": "用交付物与外部反馈校准，纯自评偏差大",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "无对标",
   "then": "对照目标岗位 JD 逐项打分，找出真实差距",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "忽视可迁移",
   "then": "区分可迁移能力（沟通/项目/分析）与岗位专属技能",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "只补短板",
   "then": "资源优先投在优势上，短板补到及格即可",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "一次性",
   "then": "能力盘点每半年一次，市场与自身都在变",
   "source": "scripts/main.py#RULES[4]"
  }
