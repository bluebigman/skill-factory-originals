{
 "name": "content-curation",
 "version": "2.0.0",
 "domain": "屏幕时间",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "短视频刷不停",
   "then": "改为选集播放（关闭自动连播），从机制上断开无限流",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "游戏沉迷",
   "then": "先了解游戏提供的满足（成就感/社交），再补真实替代",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "内容不适龄",
   "then": "用共同观看替代审查式拦截，边看边聊建立判断力",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "算法推荐",
   "then": "主动搜索替代被动推荐，训练目标式使用",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "广告诱导",
   "then": "与孩子约定遇内购先截图给家长，不即时决策",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
