{
 "name": "complaint",
 "version": "2.0.0",
 "domain": "客服回复",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "辩解",
   "then": "先道歉（对体验而非对责任）再核查，辩解会激化",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "拖延",
   "then": "投诉须在承诺时限内给出明确答复，拖延是差评主因",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "无授权",
   "then": "一线须有小额赔付授权，层层上报会恶化体验",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "超出承诺",
   "then": "不承诺无法兑现的方案，二次失约是致命伤",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "留痕",
   "then": "所有沟通留痕，纠纷处置以记录为依据",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "投诉",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "差评",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "纠纷",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
