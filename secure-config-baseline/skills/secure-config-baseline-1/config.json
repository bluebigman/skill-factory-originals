{
 "name": "secure-config-baseline-1",
 "version": "2.0.0",
 "domain": "安全配置基线",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "基线成文",
   "then": "基线文档化",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "默认安全",
   "then": "安全选项默认开",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "自动核查",
   "then": "自动核查偏离",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "偏离处置",
   "then": "偏离即告警整改",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "版本更新",
   "then": "基线随版本更新",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "基线成文",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "默认安全",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "自动核查",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "偏离处置",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "版本更新",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}