{
 "name": "subtitle-gen-coach-1",
 "version": "2.0.0",
 "domain": "字幕生成",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "单行字数",
   "then": "单行不超过 16 字，过长必换行",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "断句按语义",
   "then": "按语义断句，不按字数硬切",
   "source": "scripts/main.py#RULES[1]"
  }
 ],
 "keywords": [
  {
   "term": "单行字数",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "断句按语义",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [
  {
   "term": "时间",
   "source": "SKILL.md#L11"
  },
  {
   "term": "助手",
   "source": "SKILL.md#L11"
  }
 ],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}