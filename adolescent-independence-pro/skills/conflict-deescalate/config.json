{
 "name": "conflict-deescalate",
 "version": "2.0.0",
 "domain": "青春期独立",
 "boundary": "本能力不提供心理或医学诊断；如涉及自伤、重度抑郁等，请转介专业机构。",
 "rules": [
  {
   "when": "对骂升级",
   "then": "物理暂停（各自回房 20 分钟），先降温再谈",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "冷战",
   "then": "用非对抗渠道破冰（写字条/一起做事），不逼当场和解",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "离家出走",
   "then": "确保安全前提下不追不堵，事后只谈安全底线不谈对错",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "翻旧账",
   "then": "一次只谈一件事，禁提以往全部旧事",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "道歉",
   "then": "家长有错须明确道歉，示范承担责任比要求孩子认错更有效",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "对抗",
