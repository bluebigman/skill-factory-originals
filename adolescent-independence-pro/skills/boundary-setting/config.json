{
 "name": "boundary-setting",
 "version": "2.0.0",
 "domain": "青春期独立",
 "boundary": "本能力不提供心理或医学诊断；如涉及自伤、重度抑郁等，请转介专业机构。",
 "rules": [
  {
   "when": "翻看隐私",
   "then": "隐私是信任底线，翻手机/日记会永久损伤关系",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "交友干预",
   "then": "只对安全风险设硬边界（涉毒/涉法），其它用倾听替代否决",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "作息冲突",
   "then": "协商固定底线（如 23 点前回房）而非全程管控",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "外出报备",
   "then": "要求报备定位与同伴，但不得实时追查行踪",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "边界被试探",
   "then": "守住已声明底线的一致执行，比严厉更有效",
   "source": "scripts/main.py#RULES[4]"
  }
