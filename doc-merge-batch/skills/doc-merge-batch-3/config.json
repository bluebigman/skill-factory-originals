{
 "name": "doc-merge-batch-3",
 "version": "2.0.0",
 "domain": "多文档合并",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "顺序明确",
   "then": "先定合并顺序",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "样式统一",
   "then": "合并后统一样式",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "页码重排",
   "then": "合并后重排页码",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "目录重建",
   "then": "重建合并后目录",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "去重检查",
   "then": "检查重复章节",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "顺序明确",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "样式统一",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "页码重排",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "目录重建",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "去重检查",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}