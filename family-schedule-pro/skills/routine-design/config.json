{
 "name": "routine-design",
 "version": "2.0.0",
 "domain": "家庭日程",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "晚睡",
   "then": "固定起床时间而非就寝时间，起床时间是节律锚点",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "早晨混乱",
   "then": "前一晚完成打包（书包/衣物/早餐），早晨只做执行",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "周末错乱",
   "then": "周末起床时间与工作日差不超过 1 小时",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "作业拖延",
   "then": "固定作业启动时间与固定位置，靠提醒不如靠固定",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "全家冲突",
   "then": "卫生间等高争用资源的时段错开排布",
   "source": "scripts/main.py#RULES[4]"
  }
