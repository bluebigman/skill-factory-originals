{
 "name": "load-balance",
 "version": "2.0.0",
 "domain": "家庭日程",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "全员过载",
   "then": "列出全部固定承诺并做减法，先删除再优化",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "碎片化",
   "then": "把同类事务批量合并到固定时段处理",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "无休息",
   "then": "每周预设一段不可侵占的家庭休息时段",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "临时加塞",
   "then": "新事项加入前必须先删一项，防止无限叠加",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "孩子课外班",
   "then": "按接送成本通盘规划，单看课程质量必致全家疲于奔命",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
