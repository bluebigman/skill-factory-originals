   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "日程分散",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "接送冲突",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "忘记事项",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "临时变更",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "缓冲不足",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
