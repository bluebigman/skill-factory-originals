{
 "name": "calendar-unify",
 "version": "2.0.0",
 "domain": "家庭日程",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "日程分散",
   "then": "所有事项入同一日历并共享，分散在多处必然冲突",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "接送冲突",
   "then": "提前一周检查重叠项并预设备用接送人",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "忘记事项",
   "then": "只对需要行动的事项设提醒，全量提醒会被忽略",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "临时变更",
   "then": "变更须立即同步到日历，口头通知等于没通知",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "缓冲不足",
   "then": "行程间预留 15 分钟缓冲，零缓冲会连锁崩盘",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "日程",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "冲突",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
