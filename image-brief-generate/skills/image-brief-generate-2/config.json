{
 "name": "image-brief-generate-2",
 "version": "2.0.0",
 "domain": "配图需求描述",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "用途清晰",
   "then": "说明配图用途",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "构图描述",
   "then": "描述主体与构图",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "风格统一",
   "then": "与全文风格一致",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "尺寸明确",
   "then": "给尺寸与比例",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "版权要求",
   "then": "明确版权要求",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "用途清晰",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "构图描述",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "风格统一",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "尺寸明确",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "版权要求",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}