{
 "name": "integration-test-pro-3",
 "version": "2.0.0",
 "domain": "集成测试",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "场景真实",
   "then": "用真实链路而非桩",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "环境隔离",
   "then": "测试数据与环境隔离",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "数据准备",
   "then": "可重复的数据准备脚本",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "断言明确",
   "then": "每个场景有明确断言",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "失败可复现",
   "then": "失败须能稳定复现",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "场景真实",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "环境隔离",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "数据准备",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "断言明确",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "失败可复现",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}