{
 "name": "doc-signature-verify-3",
 "version": "2.0.0",
 "domain": "文档签署核验",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "要素齐全",
   "then": "签署人日期齐全",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "骑缝核对",
   "then": "多页文档核对骑缝",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "印章清晰",
   "then": "核对印章清晰完整",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "文本一致",
   "then": "与送签版本一致",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "归档及时",
   "then": "签署后立即归档",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "要素齐全",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "骑缝核对",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "印章清晰",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "文本一致",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "归档及时",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}