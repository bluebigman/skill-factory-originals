{
 "name": "after-sale",
 "version": "2.0.0",
 "domain": "订单处理",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "拖延",
   "then": "售后响应须及时，拖延会把小问题变成平台介入",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "无标准",
   "then": "建立退换判定标准，个案裁量会引发不公平质疑",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "过度让步",
   "then": "按规则处理，无原则让步会招致恶意退换",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "凭证",
   "then": "退货验收须留证，无证据无法主张",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "复盘",
   "then": "每周复盘售后原因并反推产品与描述问题",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
