{
 "name": "stats-method-pick-1",
 "version": "2.0.0",
 "domain": "统计方法选择",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "按数据类型选",
   "then": "连续与分类对应不同方法",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "看分布",
   "then": "不满足正态用非参",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "样本量足够",
   "then": "不足时用自助法",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "多重比较校正",
   "then": "多次检验须校正",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "报告效应量",
   "then": "不只报显著性",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "按数据类型选",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "看分布",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "样本量足够",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "多重比较校正",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "报告效应量",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}