{
 "name": "note-taking-struct-2",
 "version": "2.0.0",
 "domain": "笔记结构化整理",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "一页一主题",
   "then": "超长笔记按主题拆分",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "自建索引",
   "then": "首页维护目录",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "标签收敛",
   "then": "标签数量控制在十个以内",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "行动项单列",
   "then": "笔记末尾列待办",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "定期归并",
   "then": "同类笔记定期合并",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "一页一主题",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "自建索引",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "标签收敛",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "行动项单列",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "定期归并",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}