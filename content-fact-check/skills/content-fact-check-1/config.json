{
 "name": "content-fact-check-1",
 "version": "2.0.0",
 "domain": "内容事实核查",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "逐条核对",
   "then": "对事实性陈述逐条核查",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "来源可溯",
   "then": "每个事实标来源",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "存疑标注",
   "then": "无法核实的标注待确认",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "更新时效",
   "then": "检查数据时效性",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "不臆测",
   "then": "宁标疑不臆断",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "逐条核对",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "来源可溯",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "存疑标注",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "更新时效",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "不臆测",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}