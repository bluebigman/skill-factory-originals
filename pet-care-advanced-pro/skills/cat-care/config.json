{
 "name": "cat-care",
 "version": "2.0.0",
 "domain": "养狗",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "猫砂",
   "then": "每日清理并定期全换，气味是拒用主因",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "抓家具",
   "then": "在抓挠点设抓板并引导，事后惩罚完全无效",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "应激",
   "then": "环境变化（搬家/新成员）须给隔离适应期",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "饮水不足",
   "then": "用流动水并远离食盆，位置直接影响饮水量",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "乱尿",
   "then": "先排查泌尿健康与猫砂盆数量，行为问题放其次",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
