{
 "name": "content-brief-write-2",
 "version": "2.0.0",
 "domain": "内容需求文档",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "目标明确",
   "then": "写清内容目标",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "受众明确",
   "then": "写清目标读者",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "要点清单",
   "then": "列出必须覆盖的要点",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "参考示例",
   "then": "给参考案例",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "验收标准",
   "then": "给可判定的标准",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "目标明确",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "受众明确",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "要点清单",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "参考示例",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "验收标准",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}