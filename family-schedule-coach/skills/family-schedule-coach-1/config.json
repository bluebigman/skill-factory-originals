{
 "name": "family-schedule-coach-1",
 "version": "2.0.0",
 "domain": "家庭日程",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "统一日历",
   "then": "所有事项入同一日历",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "提前一周",
   "then": "检查重叠并设备用接送人",
   "source": "scripts/main.py#RULES[1]"
  }
 ],
 "keywords": [
  {
   "term": "统一日历",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "提前一周",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [
  {
   "term": "家庭",
   "source": "SKILL.md#L11"
  },
  {
   "term": "安排",
   "source": "SKILL.md#L11"
  },
  {
   "term": "设备",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "日程",
   "source": "SKILL.md#L11"
  }
 ],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}