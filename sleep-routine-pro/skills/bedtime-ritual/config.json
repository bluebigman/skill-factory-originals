{
 "name": "bedtime-ritual",
 "version": "2.0.0",
 "domain": "作息",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "睡前刷手机",
   "then": "睡前 1 小时远离屏幕，蓝光与信息刺激双重影响入睡",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "温度",
   "then": "睡前 1-2 小时温水沐浴，体温回落促进入睡",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "咖啡因",
   "then": "午后避免咖啡因，半衰期 5 小时以上",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "饮酒",
   "then": "酒精助眠是错觉，会破坏深睡与后半夜睡眠",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "固定程序",
   "then": "建立固定 3 步程序（洗漱-阅读-关灯），程序本身即信号",
   "source": "scripts/main.py#RULES[4]"
  }
