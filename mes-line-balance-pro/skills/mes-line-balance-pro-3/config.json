{
 "name": "mes-line-balance-pro-3",
 "version": "2.0.0",
 "domain": "产线节拍",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "实测验证",
   "then": "改动后按实际产出验证，不看理论值",
   "source": "scripts/main.py#RULES[0]"
  }
 ],
 "keywords": [
  {
   "term": "实测验证",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [
  {
   "term": "避免",
   "source": "SKILL.md#L58"
  },
  {
   "term": "优先",
   "source": "SKILL.md#L3"
  },
  {
   "term": "优化",
   "source": "SKILL.md#L11"
  },
  {
   "term": "堆积",
   "source": "SKILL.md#L58"
  },
  {
   "term": "瓶颈",
   "source": "SKILL.md#L3"
  },
  {
   "term": "平衡",
   "source": "SKILL.md#L11"
  },
  {
   "term": "动后",
   "source": "scripts/main.py#RULES.then"
  }
 ],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}