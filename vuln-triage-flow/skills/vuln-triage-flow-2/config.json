{
 "name": "vuln-triage-flow-2",
 "version": "2.0.0",
 "domain": "漏洞处置流程",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "按可利用性",
   "then": "先处理可利用的",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "误报标记",
   "then": "误报标记说明",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "修复验证",
   "then": "修复后复扫",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "存量与新增分",
   "then": "分开管理",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "不静默忽略",
   "then": "忽略须记录",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "按可利用性",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "误报标记",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "修复验证",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "存量与新增分",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "不静默忽略",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}