{
 "name": "compliance",
 "version": "2.0.0",
 "domain": "促销活动",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "虚假比价",
   "then": "划线价须真实可查，虚假比价属价格欺诈",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "极限词",
   "then": "禁用最/第一/国家级等极限词",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "赠品",
   "then": "赠品须明确数量与条件，模糊赠送易生纠纷",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "库存",
   "then": "活动库存须与承诺一致，售罄后须及时说明",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "规则公示",
   "then": "活动规则须提前公示，事后解释无效",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "合规",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "违规",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "价格",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
