   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "虚假比价",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "极限词",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "赠品",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "库存",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "规则公示",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [
