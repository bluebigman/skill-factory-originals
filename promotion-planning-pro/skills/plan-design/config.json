{
 "name": "plan-design",
 "version": "2.0.0",
 "domain": "促销活动",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "无目标",
   "then": "先定目标（清库存/拉新/提客单），目标不同机制完全不同",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "机制复杂",
   "then": "规则不超两层，复杂规则会降低参与率",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "无门槛设计",
   "then": "满减门槛按客单价上浮 10-20% 设置",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "无止损",
   "then": "设预算上限与止损线，无止损的活动可能亏损",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "无预案",
   "then": "准备爆单与冷场两套预案，无预案临场必乱",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
