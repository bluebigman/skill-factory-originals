{
 "name": "diagnose",
 "version": "2.0.0",
 "domain": "店铺数据分析",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "单日波动",
   "then": "单日波动不构成趋势，须看 7 日移动平均",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "归因单一",
   "then": "同时检查流量结构、竞品动作、平台规则与季节性",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "对比缺失",
   "then": "与上周同期、去年同期对比，孤立读数无意义",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "样本过小",
   "then": "低基数比例波动大，不可据此决策",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "外部因素",
   "then": "大促、天气、政策等外部因素须记录以免误判",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "数据异常",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "下滑",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "波动",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "诊断",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "单日波动",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "归因单一",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "对比缺失",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "样本过小",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "外部因素",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [
  {
   "term": "转化",
   "source": "SKILL.md#L11"
  },
  {
   "term": "趋势",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "平台",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "比例",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "流量",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "意义",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "同期",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "孤立",
   "source": "scripts/main.py#RULES.then"
  }
 ],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}