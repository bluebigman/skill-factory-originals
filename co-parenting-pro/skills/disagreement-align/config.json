 "rules": [
  {
   "when": "当面拆台",
   "then": "分歧绝不当孩子面争论，先按当下者的规则执行，事后私下再议",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "标准不一",
   "then": "列出 3 条绝不能不一致的底线（安全/作息/礼貌），其余允许差异",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "争论循环",
