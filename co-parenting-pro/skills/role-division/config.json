{
 "name": "role-division",
 "version": "2.0.0",
 "domain": "夫妻育儿",
 "boundary": "本能力不提供心理或医学诊断；如涉及自伤、重度抑郁等，请转介专业机构。",
 "rules": [
  {
   "when": "任务不均",
   "then": "按可支配时间而非性别分工，并把任务写清到具体动作",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "丧偶式育儿",
   "then": "把不可替代任务（每日陪睡/接送）明确指派，模糊分工必落单人",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "抱怨累积",
   "then": "每周一次 15 分钟对齐会，只谈下周安排不翻旧账",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "一方过劳",
