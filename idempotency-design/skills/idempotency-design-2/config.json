{
 "name": "idempotency-design-2",
 "version": "2.0.0",
 "domain": "幂等设计",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "请求唯一键",
   "then": "客户端生成幂等键",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "结果缓存",
   "then": "同键返回首次结果",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "状态机",
   "then": "按状态判断是否可重复执行",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "并发控制",
   "then": "加锁或唯一约束防并发重复",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "过期清理",
   "then": "幂等键定期清理",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "请求唯一键",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "结果缓存",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "状态机",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "并发控制",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "过期清理",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}