{
 "name": "fact-check-coach-2",
 "version": "2.0.0",
 "domain": "常识核查",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "多源交叉",
   "then": "至少两个独立来源相互印证",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "区分事实",
   "then": "区分事实陈述与观点表达",
   "source": "scripts/main.py#RULES[1]"
  }
 ],
 "keywords": [
  {
   "term": "多源交叉",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "区分事实",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [
  {
   "term": "时间",
   "source": "SKILL.md#L3"
  },
  {
   "term": "信息",
   "source": "SKILL.md#L11"
  },
  {
   "term": "验证",
   "source": "SKILL.md#L11"
  },
  {
   "term": "至少",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "表达",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "独立",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "陷阱",
   "source": "SKILL.md#L58"
  },
  {
   "term": "观点",
   "source": "scripts/main.py#RULES.then"
  }
 ],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}