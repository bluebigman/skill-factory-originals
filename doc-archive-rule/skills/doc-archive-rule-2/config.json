{
 "name": "doc-archive-rule-2",
 "version": "2.0.0",
 "domain": "文档归档规范",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "命名统一",
   "then": "项目-类型-版本-日期",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "目录稳定",
   "then": "目录结构一次定好不频繁改",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "双份留存",
   "then": "重要文档异地或云端各一份",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "权限分级",
   "then": "按角色设读写权限",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "保留期限",
   "then": "按法规与业务需要定保留期",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "命名统一",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "目录稳定",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "双份留存",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "权限分级",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "保留期限",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}