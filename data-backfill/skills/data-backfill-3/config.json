{
 "name": "data-backfill-3",
 "version": "2.0.0",
 "domain": "数据回补方案",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "范围明确",
   "then": "明确回补时间范围",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "幂等设计",
   "then": "回补可重复执行",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "限速执行",
   "then": "避免冲击线上",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "对账验证",
   "then": "回补后对账",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "留痕",
   "then": "记录回补范围与结果",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "范围明确",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "幂等设计",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "限速执行",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "对账验证",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "留痕",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}