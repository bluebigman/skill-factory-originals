{
 "name": "doc-stamp-control-3",
 "version": "2.0.0",
 "domain": "文档盖章管控",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "先审后盖",
   "then": "审核通过再盖章",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "范围明确",
   "then": "明确盖章范围与页数",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "登记留痕",
   "then": "盖章登记可查",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "电子章合规",
   "then": "电子章须可验证",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "用章权限",
   "then": "按权限分级用章",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "先审后盖",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "范围明确",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "登记留痕",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "电子章合规",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "用章权限",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}