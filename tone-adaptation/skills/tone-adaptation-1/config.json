{
 "name": "tone-adaptation-1",
 "version": "2.0.0",
 "domain": "语气适配改写",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "读者先行",
   "then": "按读者调语气",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "场景匹配",
   "then": "正式场景不口语化",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "一致性",
   "then": "全文语气统一",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "保留信息",
   "then": "只改语气不改事实",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "改写后比对",
   "then": "与原文核对信息量",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "读者先行",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "场景匹配",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "一致性",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "保留信息",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "改写后比对",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}