{
 "name": "education-course-design-2",
 "version": "2.0.0",
 "domain": "课程设计",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "目标先行",
   "then": "先定学习目标",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "分层设计",
   "then": "按基础分层",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "练习配套",
   "then": "每个知识点配练习",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "节奏控制",
   "then": "单次时长适中",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "评估方式",
   "then": "给评估方式",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "目标先行",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "分层设计",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "练习配套",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "节奏控制",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "评估方式",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}