   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "身体",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "健身",
   "source": "SKILL.md#L11"
  }
 ],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
