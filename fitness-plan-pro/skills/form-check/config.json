{
 "name": "form-check",
 "version": "2.0.0",
 "domain": "健身计划",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "深蹲",
   "then": "膝盖与脚尖同向，腰背中立，避免膝内扣",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "硬拉",
   "then": "全程保持背部中立，靠髋部驱动而非腰部",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "卧推",
   "then": "肩胛收紧下沉，避免肘部过度外展至 90 度",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "跑姿",
   "then": "步频 170-180 步/分，落点在身体正下方",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "宁轻勿假",
   "then": "动作变形时立即减重，代偿训练会累积损伤",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "动作",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "姿势",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "标准",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "姿势错误",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "深蹲",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "硬拉",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "卧推",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "跑姿",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "宁轻勿假",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [
  {
   "term": "避免",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "计划",
   "source": "SKILL.md#L11"
  },
  {
   "term": "安排",
   "source": "SKILL.md#L11"
  },
  {
