{
 "name": "tech-design-review-3",
 "version": "2.0.0",
 "domain": "技术方案评审",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "问题先行",
   "then": "先讲清问题再讲方案",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "备选对比",
   "then": "列备选与取舍理由",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "风险显式",
   "then": "列出风险与应对",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "可验证",
   "then": "方案含验证方式",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "限时评审",
   "then": "单次不超一小时",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "问题先行",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "备选对比",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "风险显式",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "可验证",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "限时评审",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}