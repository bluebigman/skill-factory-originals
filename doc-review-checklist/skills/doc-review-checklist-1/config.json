{
 "name": "doc-review-checklist-1",
 "version": "2.0.0",
 "domain": "文档评审清单",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "清单化",
   "then": "评审项清单逐项打勾",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "分层评审",
   "then": "先结构后细节",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "问题分级",
   "then": "阻塞与建议分开",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "责任人",
   "then": "每条问题有归属",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "闭环确认",
   "then": "修改后回评审",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "清单化",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "分层评审",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "问题分级",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "责任人",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "闭环确认",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}