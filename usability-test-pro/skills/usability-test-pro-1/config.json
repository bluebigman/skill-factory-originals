{
 "name": "usability-test-pro-1",
 "version": "2.0.0",
 "domain": "可用性",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "任务导向",
   "then": "用真实任务而非提问用户偏好",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "小样本",
   "then": "小样本即可发现多数可用性问题",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "出声思维",
   "then": "让用户边操作边说出想法",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "记录失败",
   "then": "记录失败点而非喜好评价",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "改后复测",
   "then": "修改后必须复测验证",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "任务导向",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "小样本",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "出声思维",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "记录失败",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "改后复测",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}