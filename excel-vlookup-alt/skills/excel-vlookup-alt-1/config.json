{
 "name": "excel-vlookup-alt-1",
 "version": "2.0.0",
 "domain": "表格匹配校验",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "先查唯一性",
   "then": "匹配键必须唯一",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "类型一致",
   "then": "两边键类型一致",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "缺失统计",
   "then": "匹配不上的单独列出",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "模糊匹配慎用",
   "then": "易误配",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "匹配后抽样",
   "then": "抽查若干条验证",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "先查唯一性",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "类型一致",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "缺失统计",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "模糊匹配慎用",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "匹配后抽样",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}