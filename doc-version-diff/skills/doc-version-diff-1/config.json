{
 "name": "doc-version-diff-1",
 "version": "2.0.0",
 "domain": "文档版本比对",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "差异分级",
   "then": "按实质改动/格式改动/笔误分级",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "位置明确",
   "then": "每处差异标章节与行号",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "忽略格式",
   "then": "先剥离格式再比对正文",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "批量汇总",
   "then": "多版本比对输出汇总表",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "确认机制",
   "then": "重大差异须由责任人确认后才合并",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "差异分级",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "位置明确",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "忽略格式",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "批量汇总",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "确认机制",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}