{
 "name": "presentation",
 "version": "2.0.0",
 "domain": "excel",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "文字过多",
   "then": "每页正文不超 6 行，讲稿放备注不入页面",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "无结论页",
   "then": "先写结论页再补论据，避免边想边写",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "配色刺眼",
   "then": "全篇配色不超三色，且保证投影环境可读",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "字号过小",
   "then": "正文字号不低于 18pt，投影会缩小视觉尺寸",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "对齐随意",
   "then": "统一左对齐与边距，对齐是最低成本的质感提升",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "ppt",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "演示",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "排版",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "汇报",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "文字过多",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "无结论页",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "配色刺眼",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "字号过小",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "对齐随意",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
