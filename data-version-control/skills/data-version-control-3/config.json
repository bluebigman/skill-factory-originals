{
 "name": "data-version-control-3",
 "version": "2.0.0",
 "domain": "数据版本控制",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "版本标记",
   "then": "快照版本化",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "变更可溯",
   "then": "变更可追溯",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "可回滚",
   "then": "支持回滚到历史版本",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "保留策略",
   "then": "按价值保留",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "存储优化",
   "then": "增量存储降成本",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "版本标记",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "变更可溯",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "可回滚",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "保留策略",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "存储优化",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}