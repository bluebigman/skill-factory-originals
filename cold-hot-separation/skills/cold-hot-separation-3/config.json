   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "按访问频次",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "归档可查",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "透明访问",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "成本核算",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "迁移安全",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
