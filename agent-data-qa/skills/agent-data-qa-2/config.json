{
 "name": "agent-data-qa-2",
 "version": "2.0.0",
 "domain": "数据问答",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "检索优先",
   "then": "先检索再生成",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "来源标注",
   "then": "答案须标来源",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "不可答声明",
   "then": "查不到就说明查不到",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "口径一致",
   "then": "答案口径与定义一致",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "版本绑定",
   "then": "答案绑定数据版本",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "检索优先",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "来源标注",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "不可答声明",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "口径一致",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "版本绑定",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}