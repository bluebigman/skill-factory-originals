   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "比例",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "写清",
   "source": "scripts/main.py#RULES.then"
  }
 ],
 "features": [
  "cli",
  "selftest",
  "dry-run",
