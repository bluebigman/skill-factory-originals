{
 "name": "report-layer-design-2",
 "version": "2.0.0",
 "domain": "报表层设计",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "分层构建",
   "then": "明细-汇总-应用分层",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "口径统一",
   "then": "跨报表口径一致",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "复用优先",
   "then": "优先复用已有模型",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "性能优先",
   "then": "大表走预聚合",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "生命周期",
   "then": "报表有下线机制",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "分层构建",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "口径统一",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "复用优先",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "性能优先",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "生命周期",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}