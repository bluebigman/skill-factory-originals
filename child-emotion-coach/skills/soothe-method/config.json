{
 "name": "soothe-method",
 "version": "2.0.0",
 "domain": "儿童情绪",
 "boundary": "本能力不提供心理或医学诊断；如涉及自伤、重度抑郁等，请转介专业机构。",
 "rules": [
  {
   "when": "越哄越哭",
   "then": "减少语言输入，改为身体接触+节律动作（拍背、散步）",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "崩溃大哭",
   "then": "先共情再设限：我知道你很难过，但我们不能打人",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "睡前闹",
   "then": "固定睡前程序（洗澡-故事-关灯），程序本身比哄更有效",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "分离哭",
   "then": "明确告知回来的时间点并兑现，勿偷偷离开",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "转移无效",
   "then": "转移注意仅适用 3 岁以下；大童需先处理情绪再转移",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
