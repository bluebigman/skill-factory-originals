{
 "name": "emotion-identify",
 "version": "2.0.0",
 "domain": "儿童情绪",
 "boundary": "本能力不提供心理或医学诊断；如涉及自伤、重度抑郁等，请转介专业机构。",
 "rules": [
  {
   "when": "哭闹",
   "then": "先排查生理需求（困/饿/累/身体不适），再处理情绪，勿直接讲道理",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "发脾气",
   "then": "降低刺激：抱离现场、压低音量、减少围观，成人情绪先稳住",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "打滚",
   "then": "不哄不斥，待在旁边保证安全，等强度自然回落再谈规则",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "尖叫",
   "then": "用短句+低音回应（我在），避免高频对抗激化",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "憋屈不说",
   "then": "给二选一（想说说还是先抱抱），比开放式追问更易开口",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "哭闹",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "发脾气",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "打滚",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "尖叫",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "憋屈",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "憋屈不说",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [
  {
   "term": "避免",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "重度",
   "source": "SKILL.md#L87"
  },
  {
   "term": "提供心理",
   "source": "SKILL.md#L87"
  },
  {
   "term": "医学诊断",
   "source": "SKILL.md#L87"
  },
  {
   "term": "度抑郁等",
   "source": "SKILL.md#L87"
  },
  {
   "term": "介专业机",
   "source": "SKILL.md#L87"
  },
  {
   "term": "专业机构",
   "source": "SKILL.md#L87"
  },
  {
   "term": "自伤",
   "source": "SKILL.md#L87"
  }
 ],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
