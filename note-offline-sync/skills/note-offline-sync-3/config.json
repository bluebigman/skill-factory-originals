{
 "name": "note-offline-sync-3",
 "version": "2.0.0",
 "domain": "笔记离线",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "低频大文件",
   "then": "大附件不放入同步目录",
   "source": "scripts/main.py#RULES[0]"
  }
 ],
 "keywords": [
  {
   "term": "低频大文件",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [
  {
   "term": "冲突",
   "source": "SKILL.md#L3"
  },
  {
   "term": "版本",
   "source": "SKILL.md#L57"
  },
  {
   "term": "同步",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "其余",
   "source": "SKILL.md#L58"
  },
  {
   "term": "笔记",
   "source": "SKILL.md#L11"
  }
 ],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}