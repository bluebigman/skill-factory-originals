{
 "name": "note-offline-sync-1",
 "version": "2.0.0",
 "domain": "笔记离线",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "冲突留副本",
   "then": "冲突时保留双版本，不直接覆盖",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "单一主库",
   "then": "只设一个主库，其余为副本",
   "source": "scripts/main.py#RULES[1]"
  }
 ],
 "keywords": [
  {
   "term": "冲突留副本",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "单一主库",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [
  {
   "term": "版本",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "同步",
   "source": "SKILL.md#L11"
  },
  {
   "term": "其余",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "笔记",
   "source": "SKILL.md#L11"
  }
 ],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}