{
 "name": "quality-time",
 "version": "2.0.0",
 "domain": "家庭沟通",
 "boundary": "本能力不提供心理或医学诊断；如涉及自伤、重度抑郁等，请转介专业机构。",
 "rules": [
  {
   "when": "时间碎片",
   "then": "每天固定 15 分钟一对一专属时间，胜过周末全天打折陪伴",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "陪伴变监督",
   "then": "陪伴时禁查作业/提要求，附带考核即失去陪伴意义",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "二孩冲突",
   "then": "一对一专属时间须分头进行，同场必然产生比较",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "不知道玩什么",
   "then": "按年龄给活动库：3-6 岁动作类，7-12 岁规则类，13+ 项目类",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "敷衍感",
   "then": "让孩子主导选活动并承担组织角色，参与感来自掌控感",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
