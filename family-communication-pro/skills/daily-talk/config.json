{
 "name": "daily-talk",
 "version": "2.0.0",
 "domain": "家庭沟通",
 "boundary": "本能力不提供心理或医学诊断；如涉及自伤、重度抑郁等，请转介专业机构。",
 "rules": [
  {
   "when": "封闭提问",
   "then": "改「今天怎么样」为具体场景提问（今天哪件事最麻烦）",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "说教过多",
   "then": "对话中家长发言占比控制在三分之一以内",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "正面质问",
   "then": "并肩做事时对话（开车/散步）比面对面质问更易开口",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "情绪高峰",
   "then": "冲突时先物理暂停 20 分钟，降温后再谈",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "负面开场",
   "then": "开场禁用成绩与问题清单，先建立连接再谈事",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
