{
 "name": "naming-convention-pro-3",
 "version": "2.0.0",
 "domain": "命名规范",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "约定统一",
   "then": "全项目统一命名风格",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "语义明确",
   "then": "名字体现用途不含缩写",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "长度适度",
   "then": "过短不清晰过长难读",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "层级表达",
   "then": "用命名体现模块层级",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "禁混淆",
   "then": "避免易混字与同音字",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "约定统一",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "语义明确",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "长度适度",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "层级表达",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "禁混淆",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}