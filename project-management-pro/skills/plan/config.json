{
 "name": "plan",
 "version": "2.0.0",
 "domain": "项目管理",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "任务过大",
   "then": "拆到 2 人日以内，颗粒度过大无法判断进度",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "无里程碑",
   "then": "设 3-5 个可验证里程碑，只靠最终交付会临期爆雷",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "依赖不清",
   "then": "标出跨任务依赖与关键路径，忽略依赖必致连锁延期",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "估时拍脑袋",
   "then": "参考历史同类任务时长，纯估算偏差常在 2 倍以上",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "范围蔓延",
   "then": "变更须走评估流程，免费加需求是项目失控首因",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
