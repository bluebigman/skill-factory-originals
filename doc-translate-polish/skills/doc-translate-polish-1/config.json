{
 "name": "doc-translate-polish-1",
 "version": "2.0.0",
 "domain": "文档翻译润色",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "意译优先",
   "then": "按目标语习惯重组句子",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "术语统一",
   "then": "先建术语表后全文统一",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "长句拆分",
   "then": "中文长句拆成多个短句",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "保留原文",
   "then": "专业名词首次出现附原文",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "回读校验",
   "then": "译完反向回读检查漏译",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "意译优先",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "术语统一",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "长句拆分",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "保留原文",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "回读校验",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}