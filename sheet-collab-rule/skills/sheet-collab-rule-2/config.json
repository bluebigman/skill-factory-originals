{
 "name": "sheet-collab-rule-2",
 "version": "2.0.0",
 "domain": "协作表格规范",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "锁定结构",
   "then": "表头与公式区锁定防误改",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "分工明确",
   "then": "按行或按列分配填写范围",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "数据校验",
   "then": "对关键列加数据验证",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "变更可见",
   "then": "开启修订记录",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "汇总分离",
   "then": "汇总页与录入页分开",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "锁定结构",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "分工明确",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "数据校验",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "变更可见",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "汇总分离",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}