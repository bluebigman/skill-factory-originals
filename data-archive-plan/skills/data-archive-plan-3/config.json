{
 "name": "data-archive-plan-3",
 "version": "2.0.0",
 "domain": "数据归档方案",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "冷热分离",
   "then": "按访问频率分层",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "归档可查",
   "then": "归档后仍可检索",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "压缩与校验",
   "then": "归档时校验完整性",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "保留期明确",
   "then": "按法规与业务定",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "恢复演练",
   "then": "定期验证可恢复",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "冷热分离",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "归档可查",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "压缩与校验",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "保留期明确",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "恢复演练",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}