{
 "name": "content-metrics-define-1",
 "version": "2.0.0",
 "domain": "内容指标定义",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "口径唯一",
   "then": "同一指标同一口径",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "可获取",
   "then": "指标可从现有数据取",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "可行动",
   "then": "指标对应具体动作",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "分层",
   "then": "过程指标与结果指标分层",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "定期复核",
   "then": "随目标调整",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "口径唯一",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "可获取",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "可行动",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "分层",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "定期复核",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}