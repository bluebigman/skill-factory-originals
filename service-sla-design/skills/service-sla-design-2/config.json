{
 "name": "service-sla-design-2",
 "version": "2.0.0",
 "domain": "服务承诺设计",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "可兑现",
   "then": "承诺须可兑现",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "指标明确",
   "then": "量化承诺指标",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "例外说明",
   "then": "写明例外情况",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "违约处理",
   "then": "违约如何处理",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "定期复核",
   "then": "按数据复核",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "可兑现",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "指标明确",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "例外说明",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "违约处理",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "定期复核",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}