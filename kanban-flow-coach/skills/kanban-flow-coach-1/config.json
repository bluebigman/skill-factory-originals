  },
  {
   "term": "设定",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "堆积",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "瓶颈",
   "source": "scripts/main.py#RULES.then"
  }
 ],
 "features": [
  "cli",
  "selftest",
