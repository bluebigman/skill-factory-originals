{
 "name": "organize",
 "version": "2.0.0",
 "domain": "知识管理",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "无索引",
   "then": "每条只写一个观点并给可检索标题",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "孤立",
   "then": "新条目必须链接至少一条旧条目，孤立条目等于垃圾",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "分类过重",
   "then": "按标签而非文件夹层级，层级过深无法维护",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "原文堆砌",
   "then": "写自己的理解，原文另存附件",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "数量焦虑",
   "then": "价值在复用不在数量，定期合并重复项",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
