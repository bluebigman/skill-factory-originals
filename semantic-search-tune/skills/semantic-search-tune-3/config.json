{
 "name": "semantic-search-tune-3",
 "version": "2.0.0",
 "domain": "语义检索调优",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "分块合理",
   "then": "按语义边界分块",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "元数据丰富",
   "then": "附标题与来源",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "混合检索",
   "then": "关键词与向量混合",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "重排优化",
   "then": "加一层重排",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "评测集",
   "then": "建查询-答案评测集",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "分块合理",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "元数据丰富",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "混合检索",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "重排优化",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "评测集",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}