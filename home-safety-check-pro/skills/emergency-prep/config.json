{
 "name": "emergency-prep",
 "version": "2.0.0",
 "domain": "居家安全",
 "boundary": "本能力不提供心理或医学诊断；如涉及自伤、重度抑郁等，请转介专业机构。",
 "rules": [
  {
   "when": "无预案",
   "then": "全家演练一次逃生路线并约定集合点",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "物资过期",
   "then": "急救箱每半年检查有效期并补齐",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "燃气泄漏",
   "then": "先开窗关阀撤离再报警，切勿在现场开关电器",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "火灾",
   "then": "低姿撤离并湿毛巾捂口鼻，不乘电梯",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "急救",
   "then": "严重外伤/窒息/昏迷立即拨打急救电话，本工具不做医疗处置",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
