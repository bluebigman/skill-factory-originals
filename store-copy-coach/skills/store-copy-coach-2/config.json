{
 "name": "store-copy-coach-2",
 "version": "2.0.0",
 "domain": "商品文案",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "证据支撑",
   "then": "参数/认证/实测",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "主卖点≤3",
   "then": "过多等于没有",
   "source": "scripts/main.py#RULES[1]"
  }
 ],
 "keywords": [
  {
   "term": "证据支撑",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "主卖点≤3",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [
  {
   "term": "差异",
   "source": "SKILL.md#L3"
  },
  {
   "term": "文案",
   "source": "SKILL.md#L11"
  },
  {
   "term": "参数",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "痛点",
   "source": "SKILL.md#L3"
  },
  {
   "term": "商品",
   "source": "SKILL.md#L11"
  },
  {
   "term": "放大",
   "source": "SKILL.md#L58"
  },
  {
   "term": "实测",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "异化",
   "source": "SKILL.md#L3"
  }
 ],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}