{
 "name": "agent-doc-pipeline-1",
 "version": "2.0.0",
 "domain": "文档流水",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "解析保真",
   "then": "解析须保留原始结构",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "结构化",
   "then": "输出统一结构化格式",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "幂等入库",
   "then": "重复入库须去重",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "异常隔离",
   "then": "单份失败不阻塞",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "质量抽检",
   "then": "入库后抽样核对",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "解析保真",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "结构化",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "幂等入库",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "异常隔离",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "质量抽检",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}