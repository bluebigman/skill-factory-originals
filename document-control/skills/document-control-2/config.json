{
 "name": "document-control-2",
 "version": "2.0.0",
 "domain": "文件受控管理",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "编号唯一",
   "then": "文件编号唯一",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "版本受控",
   "then": "版本受控发放",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "回收机制",
   "then": "旧版回收",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "发放登记",
   "then": "发放记录可查",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "定期审查",
   "then": "定期审查有效性",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "编号唯一",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "版本受控",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "回收机制",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "发放登记",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "定期审查",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}