  {
   "when": "边界显式",
   "then": "明确写出不做什么，比写做什么更能防返工",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "用户语言",
   "then": "需求描述用用户能懂的话，术语另附词汇表",
   "source": "scripts/main.py#RULES[1]"
  }
 ],
 "keywords": [
