{
 "name": "product-spec-write-1",
 "version": "2.0.0",
 "domain": "产品需求",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "目标先写",
   "then": "文档开头必须写清要解决什么问题，不是写功能列表",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "验收可测",
   "then": "每条需求配一条可测量、可判定的验收标准",
   "source": "scripts/main.py#RULES[1]"
  }
 ],
 "keywords": [
  {
   "term": "目标先写",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "验收可测",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [
  {
   "term": "开头",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "每条",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "判定",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "写清",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "文档",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "产品",
   "source": "SKILL.md#L11"
  }
 ],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}