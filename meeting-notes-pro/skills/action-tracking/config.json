{
 "name": "action-tracking",
 "version": "2.0.0",
 "domain": "会议纪要",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "无人认领",
   "then": "行动项必须落到具名个人，落部门等于没人做",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "无期限",
   "then": "所有行动项必须有具体日期，写「尽快」的一律驳回",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "跟踪失效",
   "then": "下次会议首项议程固定为上次行动项核对",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "逾期无后果",
   "then": "逾期项须当场说明并给出新期限，无成本必持续逾期",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "完成判定",
   "then": "完成标准须可验证（交付物/签字/上线），模糊标准导致扯皮",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "行动项",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "跟踪",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "落实",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "催办",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "无人认领",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "无期限",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "跟踪失效",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "逾期无后果",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "完成判定",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [
  {
   "term": "固定",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "成本",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "验证",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "持续",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "日期",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "交付",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "导致",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "当场",
   "source": "scripts/main.py#RULES.then"
  }
 ],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}