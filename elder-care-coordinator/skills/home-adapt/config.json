{
 "name": "home-adapt",
 "version": "2.0.0",
 "domain": "老人照护",
 "boundary": "本能力不提供心理或医学诊断；如涉及自伤、重度抑郁等，请转介专业机构。",
 "rules": [
  {
   "when": "跌倒",
   "then": "优先处理地面（防滑垫/去门槛）与照明（夜灯），成本最低收益最高",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "如厕",
   "then": "卫生间加装扶手是第一优先改造项",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "动线",
   "then": "清除主要动线上的杂物与电线，通道净宽保持 80cm 以上",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "紧急联络",
   "then": "设置一键呼叫（大字/语音），复杂操作在紧急时必然失效",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "适老改造",
   "then": "改造前先观察一周真实动线，凭想象改造往往用不上",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
