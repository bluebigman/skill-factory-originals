{
 "name": "companion-visit",
 "version": "2.0.0",
 "domain": "老人照护",
 "boundary": "本能力不提供心理或医学诊断；如涉及自伤、重度抑郁等，请转介专业机构。",
 "rules": [
  {
   "when": "信息不全",
   "then": "提前整理用药清单与既往病史一页纸，现场回忆必遗漏",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "听不清医嘱",
   "then": "现场录音并当场复述确认，回去再回忆必出错",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "多科就诊",
   "then": "整理时间线（何时起病/何药无效），按时间顺序陈述",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "用药冲突",
   "then": "就诊时出示全部在服药物（含保健品），避免重复用药",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "诊断疑问",
   "then": "本工具不提供判断，只协助组织信息，诊断一律以医生为准",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
