{
 "name": "care-plan",
 "version": "2.0.0",
 "domain": "老人照护",
 "boundary": "本能力不提供心理或医学诊断；如涉及自伤、重度抑郁等，请转介专业机构。",
 "rules": [
  {
   "when": "全落一人",
   "then": "把照护任务拆到具体动作并排班，模糊轮值必落单人",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "异地照护",
   "then": "异地者承担可远程的项（费用/预约/物资），避免仅出钱不出力争议",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "照护疲劳",
   "then": "排班必须含整块休息期，照护者先崩溃则全盘瓦解",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "多人意见",
   "then": "设一名主责人做最终决定，集体决策在紧急时必然延误",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "费用分摊",
   "then": "按能力协商并书面记录，口头约定后期必生争议",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
