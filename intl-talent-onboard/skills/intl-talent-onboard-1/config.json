{
 "name": "intl-talent-onboard-1",
 "version": "2.0.0",
 "domain": "海外招聘",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "合同合规",
   "then": "合同条款按当地法定要求拟定",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "口径明确",
   "then": "明确税前税后与发放周期",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "时区友好",
   "then": "培训安排避开对方休息时段",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "文化导入",
   "then": "提供当地职场文化说明",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "标准前置",
   "then": "试用期验收标准提前告知",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "合同合规",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "口径明确",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "时区友好",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "文化导入",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "标准前置",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}