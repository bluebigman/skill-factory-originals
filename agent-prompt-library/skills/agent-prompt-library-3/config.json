{
 "name": "agent-prompt-library-3",
 "version": "2.0.0",
 "domain": "提示库",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "复用优先",
   "then": "优先复用已有模板",
   "source": "scripts/main.py#RULES[0]"
  }
 ],
 "keywords": [
  {
   "term": "复用优先",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [
  {
   "term": "模板",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "定义",
   "source": "SKILL.md#L58"
  },
  {
   "term": "常用",
   "source": "SKILL.md#L57"
  }
 ],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}