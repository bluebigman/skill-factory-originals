{
 "name": "transcript-qa-extract-2",
 "version": "2.0.0",
 "domain": "转写稿",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "保留出处",
   "then": "每个要点标注在原文的位置",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "冲突并列",
   "then": "原文自相矛盾时并列呈现不取舍",
   "source": "scripts/main.py#RULES[1]"
  }
 ],
 "keywords": [
  {
   "term": "保留出处",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "冲突并列",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [
  {
   "term": "助手",
   "source": "SKILL.md#L11"
  },
  {
   "term": "先定",
   "source": "SKILL.md#L3"
  },
  {
   "term": "标注",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "前先",
   "source": "SKILL.md#L57"
  },
  {
   "term": "回答",
   "source": "SKILL.md#L57"
  },
  {
   "term": "段落",
   "source": "SKILL.md#L58"
  },
  {
   "term": "矛盾",
   "source": "scripts/main.py#RULES.then"
  }
 ],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}