{
 "name": "transcript-qa-extract-1",
 "version": "2.0.0",
 "domain": "转写稿",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "先定问题",
   "then": "抽取前先列要回答的问题清单",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "按问题取段",
   "then": "按问题定位原文段落再归纳",
   "source": "scripts/main.py#RULES[1]"
  }
 ],
 "keywords": [
  {
   "term": "先定问题",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "按问题取段",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [
  {
   "term": "助手",
   "source": "SKILL.md#L11"
  },
  {
   "term": "前先",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "回答",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "段落",
   "source": "scripts/main.py#RULES.then"
  }
 ],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}