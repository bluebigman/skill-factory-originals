{
 "name": "session-security-3",
 "version": "2.0.0",
 "domain": "会话安全",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "令牌短时效",
   "then": "访问令牌短期有效",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "刷新分离",
   "then": "刷新令牌单独存放",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "登出即失效",
   "then": "登出后令牌立即失效",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "绑定信息",
   "then": "必要时绑定设备或 IP 段",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "并发限制",
   "then": "限制同账号并发会话",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "令牌短时效",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "刷新分离",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "登出即失效",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "绑定信息",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "并发限制",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}