   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "业务对齐",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "季度节奏",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "单点预警",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "高层互动",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
