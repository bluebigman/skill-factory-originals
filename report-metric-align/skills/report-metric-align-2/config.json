{
 "name": "report-metric-align-2",
 "version": "2.0.0",
 "domain": "报表口径对齐",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "同一指标同一口径",
   "then": "跨报表必须一致",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "差异显式",
   "then": "有差异必说明原因",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "责任人",
   "then": "每个口径有归属人",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "变更通告",
   "then": "口径变更通知使用方",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "下线机制",
   "then": "废弃报表及时下线",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "同一指标同一口径",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "差异显式",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "责任人",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "变更通告",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "下线机制",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}