{
 "name": "privacy-compliance-1",
 "version": "2.0.0",
 "domain": "隐私合规",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "最小必要",
   "then": "只收集业务必需的数据",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "明示用途",
   "then": "收集前明示用途与保存期限",
   "source": "scripts/main.py#RULES[1]"
  }
 ],
 "keywords": [
  {
   "term": "最小必要",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "明示用途",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [
  {
   "term": "隐私",
   "source": "SKILL.md#L11"
  }
 ],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}