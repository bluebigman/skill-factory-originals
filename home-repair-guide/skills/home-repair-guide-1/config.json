{
 "name": "home-repair-guide-1",
 "version": "2.0.0",
 "domain": "家居维修",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "描述问题",
   "then": "按现象+时间+已尝试记录",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "比价",
   "then": "对比 2-3 家并按明细比",
   "source": "scripts/main.py#RULES[1]"
  }
 ],
 "keywords": [
  {
   "term": "描述问题",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "比价",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [
  {
   "term": "时间",
   "source": "scripts/main.py#RULES.then"
  }
 ],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}