{
 "name": "game-qa-method-1",
 "version": "2.0.0",
 "domain": "游戏测试",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "主流程优先",
   "then": "先覆盖主流程与主线",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "边界异常",
   "then": "边界与异常优先于重复用例",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "组合覆盖",
   "then": "对关键参数做组合覆盖",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "回归清单",
   "then": "维护回归清单并随版本更新",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "缺陷分级",
   "then": "按影响面分级定修复顺序",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "主流程优先",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "边界异常",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "组合覆盖",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "回归清单",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "缺陷分级",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}