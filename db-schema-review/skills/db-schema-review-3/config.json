{
 "name": "db-schema-review-3",
 "version": "2.0.0",
 "domain": "数据库设计",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "不存冗余",
   "then": "冗余字段须写明一致性维护方案",
   "source": "scripts/main.py#RULES[0]"
  }
 ],
 "keywords": [
  {
   "term": "不存冗余",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [
  {
   "term": "设计",
   "source": "SKILL.md#L11"
  },
  {
   "term": "方案",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "写明",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "维护",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "索引",
   "source": "SKILL.md#L3"
  },
  {
   "term": "致性",
   "source": "scripts/main.py#RULES.then"
  }
 ],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}