 "rules": [
  {
   "when": "先排固定",
   "then": "先放固定事项，再填空隙",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "留缓冲",
   "then": "块间留 15 分钟缓冲",
   "source": "scripts/main.py#RULES[1]"
  }
 ],
 "keywords": [
  {
   "term": "先排固定",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "留缓冲",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [
  {
   "term": "时间",
   "source": "SKILL.md#L11"
  },
  {
   "term": "分钟",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "编排",
   "source": "SKILL.md#L11"
  },
  {
   "term": "日程",
   "source": "SKILL.md#L11"
  }
 ],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
