{
 "name": "doc-retrieval-eval-1",
 "version": "2.0.0",
 "domain": "检索效果评测",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "评测集",
   "then": "建查询与标准答案集",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "指标",
   "then": "召回率与准确率",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "分层评测",
   "then": "按查询类型分层",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "回归",
   "then": "改动后回归评测",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "持续优化",
   "then": "按失分项优化",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "评测集",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "指标",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "分层评测",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "回归",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "持续优化",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}