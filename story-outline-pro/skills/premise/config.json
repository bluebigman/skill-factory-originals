{
 "name": "premise",
 "version": "2.0.0",
 "domain": "故事大纲",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "无冲突",
   "then": "没有冲突就没有故事，先定核心矛盾",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "主角被动",
   "then": "主角必须有明确欲望并主动行动，被动主角无吸引力",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "设定堆砌",
   "then": "设定只服务于冲突，无关设定会拖垮节奏",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "主题模糊",
   "then": "主题用一个问题表达（人能否被原谅），模糊则散",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "无代价",
   "then": "选择的代价决定张力，无代价的抉择不成立",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
