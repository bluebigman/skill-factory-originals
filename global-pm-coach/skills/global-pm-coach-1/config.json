{
 "name": "global-pm-coach-1",
 "version": "2.0.0",
 "domain": "跨国项目",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "单一计划",
   "then": "全球共用一份主计划",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "本地差异",
   "then": "允许本地执行方式差异但里程碑一致",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "口径统一",
   "then": "里程碑与验收口径统一",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "会议轮转",
   "then": "例会时间在各时区间轮转",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "风险共见",
   "then": "风险清单对全员可见",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "单一计划",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "本地差异",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "口径统一",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "会议轮转",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "风险共见",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}