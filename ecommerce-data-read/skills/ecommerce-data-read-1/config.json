   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "次只",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "点击",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "指标",
   "source": "SKILL.md#L11"
  },
  {
   "term": "复购",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "只改",
   "source": "scripts/main.py#RULES.then"
  }
