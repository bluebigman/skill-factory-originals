{
 "name": "quality-bar-define-2",
 "version": "2.0.0",
 "domain": "质量标准定义",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "可判定",
   "then": "标准须可客观判定",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "分级",
   "then": "区分阻塞与建议",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "示例",
   "then": "每条标准配正反例",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "责任人",
   "then": "每项标准有负责人",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "定期复核",
   "then": "随业务调整",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "可判定",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "分级",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "示例",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "责任人",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "定期复核",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}