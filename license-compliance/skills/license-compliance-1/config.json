{
 "name": "license-compliance-1",
 "version": "2.0.0",
 "domain": "许可证合规",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "全量清单",
   "then": "列出全部依赖",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "许可证归类",
   "then": "按传染性分类",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "商用兼容",
   "then": "确认商用兼容",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "冲突处置",
   "then": "冲突则替换",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "随版本更新",
   "then": "升级时重查",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "全量清单",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "许可证归类",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "商用兼容",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "冲突处置",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "随版本更新",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}