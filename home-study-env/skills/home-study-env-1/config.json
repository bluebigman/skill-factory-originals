{
 "name": "home-study-env-1",
 "version": "2.0.0",
 "domain": "学习环境",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "桌面清空",
   "then": "桌面只留当前任务用品",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "视线无干扰",
   "then": "视线内不出现电子产品",
   "source": "scripts/main.py#RULES[1]"
  }
 ],
 "keywords": [
  {
   "term": "桌面清空",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "视线无干扰",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [
  {
   "term": "任务",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "学习",
   "source": "SKILL.md#L11"
  },
  {
   "term": "产品",
   "source": "scripts/main.py#RULES.then"
  }
 ],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}