{
 "name": "doc-graph-build-2",
 "version": "2.0.0",
 "domain": "文档图谱构建",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "实体识别",
   "then": "先识别核心实体",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "关系定义",
   "then": "定义实体间关系类型",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "来源可溯",
   "then": "每条关系标来源",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "增量更新",
   "then": "支持增量构建",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "可视化",
   "then": "提供图谱可视化",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "实体识别",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "关系定义",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "来源可溯",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "增量更新",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "可视化",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}