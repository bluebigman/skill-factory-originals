{
 "name": "contract-risk-read-1",
 "version": "2.0.0",
 "domain": "合同风险",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "先看四要件",
   "then": "主体-标的-价款-期限是否明确",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "违约责任",
   "then": "重点看违约与赔偿是否对等",
   "source": "scripts/main.py#RULES[1]"
  }
 ],
 "keywords": [
  {
   "term": "先看四要件",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "违约责任",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [
  {
   "term": "风险",
   "source": "SKILL.md#L11"
  },
  {
   "term": "重点",
   "source": "scripts/main.py#RULES.then"
  }
 ],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}