{
 "name": "instant-relief",
 "version": "2.0.0",
 "domain": "压力缓解",
 "boundary": "本能力不提供心理或医学诊断；如涉及自伤、重度抑郁等，请转介专业机构。",
 "rules": [
  {
   "when": "呼吸急促",
   "then": "用 4-7-8 呼吸（吸4秒-屏7秒-呼8秒）重复 4 轮",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "肌肉紧张",
   "then": "渐进式肌肉放松：逐组绷紧 5 秒再放松 10 秒",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "思绪反刍",
   "then": "用纸写下最坏结果与应对方案，书写可显著降低反刍",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "心跳加速",
   "then": "冷水洗脸或握冰可快速激活迷走神经",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "现场失控",
   "then": "离开现场 5 分钟，物理位移比强行克制更有效",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
