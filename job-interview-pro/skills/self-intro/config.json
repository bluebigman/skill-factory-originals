{
 "name": "self-intro",
 "version": "2.0.0",
 "domain": "面试准备",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "流水账",
   "then": "按「现在-过去-为什么是我」结构，控制在 90 秒内",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "无针对性",
   "then": "按岗位 JD 挑 2 个最强匹配点，通用版必失焦",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "无量化",
   "then": "成果必须量化（提升30%/节省200小时），形容词无说服力",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "与简历重复",
   "then": "简历写事实，口头讲判断与思考，重复叙述浪费时间",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "过度谦让",
   "then": "直接说清能解决对方什么问题，谦让会削弱说服力",
   "source": "scripts/main.py#RULES[4]"
  }
