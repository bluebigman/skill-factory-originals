{
 "name": "data-archival-pro-1",
 "version": "2.0.0",
 "domain": "数据归档",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "分层策略",
   "then": "按访问频率分层",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "归档可查",
   "then": "归档数据须可查",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "成本核算",
   "then": "分层对比成本",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "恢复时限",
   "then": "恢复时间须明确",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "合规保留",
   "then": "满足合规保留期",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "分层策略",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "归档可查",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "成本核算",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "恢复时限",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "合规保留",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}