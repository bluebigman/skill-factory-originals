{
 "name": "intl-logistics-pro-3",
 "version": "2.0.0",
 "domain": "国际物流",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "多式比选",
   "then": "比选运输方式、时效与成本",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "清关准备",
   "then": "提前备齐清关资料",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "节点可视",
   "then": "关键节点状态可见",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "旺季预判",
   "then": "旺季提前订舱并锁定舱位",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "异常预案",
   "then": "准备改配与转口预案",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "多式比选",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "清关准备",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "节点可视",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "旺季预判",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "异常预案",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}