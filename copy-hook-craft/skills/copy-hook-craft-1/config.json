{
 "name": "copy-hook-craft-1",
 "version": "2.0.0",
 "domain": "文案钩子打磨",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "痛点前置",
   "then": "首句写用户痛点",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "具体优于抽象",
   "then": "用数字与场景",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "一个卖点",
   "then": "一条文案只打一个点",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "行动明确",
   "then": "结尾给明确动作",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "避免夸张",
   "then": "不做无法验证的承诺",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "痛点前置",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "具体优于抽象",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "一个卖点",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "行动明确",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "避免夸张",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}