{
 "name": "chore-plan",
 "version": "2.0.0",
 "domain": "家庭事务",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "一人全包",
   "then": "把家务拆到最小动作并分配到人，模糊的帮忙必落单人",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "拒不执行",
   "then": "用固定时段（晚饭后 20 分钟）集体做，比各自催更有效",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "质量标准不一",
   "then": "先定义可接受标准（碗无水渍即可），完美主义激化冲突",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "孩子不参与",
   "then": "按年龄分配可完成项，并删除家长的二次返工",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "外包决策",
   "then": "按时间成本判断：小时工资高于外包价的必须外包",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
