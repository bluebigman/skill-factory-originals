{
 "name": "data-access-request-3",
 "version": "2.0.0",
 "domain": "数据取用流程",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "申请先行",
   "then": "先申请后取用",
