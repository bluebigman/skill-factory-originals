  },
  {
   "term": "教练",
   "source": "SKILL.md#L11"
  },
  {
   "term": "事后",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "复述",
   "source": "scripts/main.py#RULES.then"
