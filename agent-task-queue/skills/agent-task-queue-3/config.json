{
 "name": "agent-task-queue-3",
 "version": "2.0.0",
 "domain": "任务队列",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "优先级",
   "then": "明确定义优先级规则",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "防饿死",
   "then": "低优先级须有保底",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "幂等入队",
   "then": "重复入队须去重",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "超时处理",
   "then": "任务超时须处理",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "可视化",
   "then": "队列状态可观测",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "优先级",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "防饿死",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "幂等入队",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "超时处理",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "可视化",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}