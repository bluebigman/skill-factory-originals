{
 "name": "sell-talk",
 "version": "2.0.0",
 "domain": "直播话术",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "无信任",
   "then": "先给专业判断再讲价格，纯低价无长期转化",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "逼单生硬",
   "then": "给紧迫理由（限量/限时）须真实，虚假会反噬",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "异议处理",
   "then": "预设「价格贵/不需要」等异议并准备回应",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "重复话术",
   "then": "同一话术 30 分钟以上须换表达，重复会流失",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "禁用词",
   "then": "禁用国家级/最高级等极限词，禁虚假比价",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "带货",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
