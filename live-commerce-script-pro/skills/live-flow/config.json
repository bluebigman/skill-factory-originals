{
 "name": "live-flow",
 "version": "2.0.0",
 "domain": "直播话术",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "无流程",
   "then": "按分钟切分（开场-留人-讲品-逼单-收尾），无流程必冷场",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "开场弱",
   "then": "开场 3 分钟必须给留人理由（福利/悬念）",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "讲品冗长",
   "then": "单品讲解控制 5-8 分钟，过长会流失",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "节奏单一",
   "then": "每 10-15 分钟设一次互动或福利节点",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "收尾",
   "then": "收尾预告下场并给关注理由",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
