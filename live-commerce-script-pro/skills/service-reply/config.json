{
 "name": "service-reply",
 "version": "2.0.0",
 "domain": "直播话术",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "回复慢",
   "then": "首次响应控制 30 秒内，响应时长直接影响转化",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "模板味",
   "then": "模板须个性化（称呼+具体问题），纯模板被视为敷衍",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "答非所问",
   "then": "先复述客户问题再回答，确认理解一致",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "投诉激化",
   "then": "先道歉（对体验而非责任）再核查，辩解会激化",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "留痕",
   "then": "所有沟通留痕，纠纷处置以记录为依据",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "客服话术",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "回复",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "投诉",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "售后",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "回复慢",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "模板味",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "答非所问",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "投诉激化",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "留痕",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [
  {
   "term": "分钟",
   "source": "SKILL.md#L63"
  },
  {
   "term": "节奏",
   "source": "SKILL.md#L3"
  },
  {
   "term": "影响",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "流程",
   "source": "SKILL.md#L3"
  },
  {
   "term": "控制",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "转化",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "理解",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "依据",
   "source": "scripts/main.py#RULES.then"
  }
 ],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}