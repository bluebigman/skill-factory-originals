{
 "name": "short-video-script-1",
 "version": "2.0.0",
 "domain": "短视频",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "前 3 秒钩子",
   "then": "开头直接给冲突或结论",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "单点",
   "then": "一条视频只讲一个点",
   "source": "scripts/main.py#RULES[1]"
  }
 ],
 "keywords": [
  {
   "term": "前 3 秒钩子",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "单点",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [
  {
   "term": "冲突",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "开头",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "拆解",
   "source": "SKILL.md#L11"
  },
  {
   "term": "只讲",
   "source": "scripts/main.py#RULES.then"
  }
 ],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}