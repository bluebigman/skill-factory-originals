{
 "name": "log-to-metric-3",
 "version": "2.0.0",
 "domain": "日志转指标",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "结构化优先",
   "then": "先结构化再聚合",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "采样策略",
   "then": "高频日志采样",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "基数控制",
   "then": "控制标签基数",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "聚合窗口",
   "then": "定义聚合窗口",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "成本平衡",
   "then": "平衡精度与成本",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "结构化优先",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "采样策略",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "基数控制",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "聚合窗口",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "成本平衡",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}