{
 "name": "agent-continuous-check-2",
 "version": "2.0.0",
 "domain": "持续检查",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "失败告警",
   "then": "失败即告警",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "报告可读",
   "then": "报告须可读",
   "source": "scripts/main.py#RULES[1]"
  }
 ],
 "keywords": [
  {
   "term": "失败告警",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "报告可读",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [
  {
   "term": "优先",
   "source": "SKILL.md#L3"
  },
  {
   "term": "任务",
   "source": "SKILL.md#L57"
  },
  {
   "term": "定时",
   "source": "SKILL.md#L3"
  },
  {
   "term": "持续",
   "source": "SKILL.md#L11"
  }
 ],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}