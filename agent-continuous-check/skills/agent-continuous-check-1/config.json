{
 "name": "agent-continuous-check-1",
 "version": "2.0.0",
 "domain": "持续检查",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "定时可靠",
   "then": "定时任务须可靠",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "增量优先",
   "then": "优先增量检查",
   "source": "scripts/main.py#RULES[1]"
  }
 ],
 "keywords": [
  {
   "term": "定时可靠",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "增量优先",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [
  {
   "term": "任务",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "持续",
   "source": "SKILL.md#L11"
  }
 ],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}