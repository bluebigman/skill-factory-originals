{
 "name": "weekly-menu",
 "version": "2.0.0",
 "domain": "家庭餐食",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "每天纠结",
   "then": "周末一次定 7 天菜单并生成采购清单，决策次数从 21 降到 1",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "口味不合",
   "then": "按人头各留 1 天独食日，全员迁就必引发抱怨",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "重复单调",
   "then": "主料轮换（鸡/猪/牛/鱼/蛋/豆），主食与烹饪法交叉搭配",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "做不完浪费",
   "then": "按现有库存定菜单而非反向采购，先清库存再下单",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "时间不够",
   "then": "按耗时分级：工作日 30 分钟菜，周末做费时菜",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
