{
 "name": "prep-batch",
 "version": "2.0.0",
 "domain": "家庭餐食",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "工作日没时间",
   "then": "周末集中预处理（洗切分装），工作日只做加热与调味",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "变质浪费",
   "then": "分装按单次用量，反复解冻是变质主因",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "冷冻串味",
   "then": "按类别分区并标日期，生熟分层",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "叶菜发黄",
   "then": "叶菜不预洗，用厨房纸包裹冷藏，洗后即烂",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "剩菜",
   "then": "剩菜 24 小时内复热一次，超时不留",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
