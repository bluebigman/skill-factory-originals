{
 "name": "newsletter-coach-1",
 "version": "2.0.0",
 "domain": "订阅通讯",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "固定节奏",
   "then": "保持固定的发送节奏",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "单一主题",
   "then": "每期聚焦一个主题",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "价值前置",
   "then": "开头直接给要点",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "适合扫读",
   "then": "排版便于快速扫读",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "退订简单",
   "then": "退订流程足够简单",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "固定节奏",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "单一主题",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "价值前置",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "适合扫读",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "退订简单",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}