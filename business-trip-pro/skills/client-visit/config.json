  },
  {
   "term": "管理",
   "source": "SKILL.md#L3"
  },
  {
   "term": "安排",
   "source": "SKILL.md#L11"
  },
  {
   "term": "现场",
   "source": "scripts/main.py#RULES.then"
  }
 ],
 "features": [
  "cli",
  "selftest",
