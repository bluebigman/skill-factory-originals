{
 "name": "illustration-guide-1",
 "version": "2.0.0",
 "domain": "插画风格指南",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "风格统一",
   "then": "全局统一风格",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "语义一致",
   "then": "同概念同形象",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "尺寸适配",
   "then": "适配不同尺寸",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "可复用",
   "then": "建立素材库",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "版权清晰",
   "then": "确认授权来源",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "风格统一",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "语义一致",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "尺寸适配",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "可复用",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "版权清晰",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}