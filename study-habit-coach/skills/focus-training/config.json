{
 "name": "focus-training",
 "version": "2.0.0",
 "domain": "背单词",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "注意力",
   "then": "从15分钟起步逐周加5分钟，配计时器可视化",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "坐不住",
   "then": "允许站立/走动式学习，不强制静坐",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "走神",
   "then": "走神时记录打断内容，事后统一处理",
   "source": "scripts/main.py#RULES[2]"
  }
 ],
