{
 "name": "review-loop",
 "version": "2.0.0",
 "domain": "背单词",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "记不住",
   "then": "按1天/3天/7天三次复习，用自测而非重读",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "复习",
   "then": "先合书自述，再翻书核对缺口",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "遗忘",
   "then": "把错的题单独建错题本，每周重做",
   "source": "scripts/main.py#RULES[2]"
  }
 ],
 "keywords": [
