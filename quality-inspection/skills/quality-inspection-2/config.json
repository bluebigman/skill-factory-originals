{
 "name": "quality-inspection-2",
 "version": "2.0.0",
 "domain": "质量检验规范",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "标准明确",
   "then": "检验标准量化",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "抽样方法",
   "then": "抽样规则明确",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "判定规则",
   "then": "合格判定规则",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "记录留痕",
   "then": "检验记录归档",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "不合格处置",
   "then": "处置流程明确",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "标准明确",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "抽样方法",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "判定规则",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "记录留痕",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "不合格处置",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}