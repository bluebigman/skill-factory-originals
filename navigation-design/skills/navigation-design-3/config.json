{
 "name": "navigation-design-3",
 "version": "2.0.0",
 "domain": "导航设计",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "位置可见",
   "then": "始终显示当前位置",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "可回溯",
   "then": "任何页面可返回上级",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "常用前置",
   "then": "高频入口前置不埋深",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "命名一致",
   "then": "导航项与页面标题一致",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "深链可达",
   "then": "支持链接直达具体页面",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "位置可见",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "可回溯",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "常用前置",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "命名一致",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "深链可达",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}