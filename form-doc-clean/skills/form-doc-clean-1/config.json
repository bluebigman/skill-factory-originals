{
 "name": "form-doc-clean-1",
 "version": "2.0.0",
 "domain": "表单文档清洗",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "先看分布",
   "then": "清洗前统计各字段空值率",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "空串转空",
   "then": "连续空格与空串统一为 null",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "枚举归一",
   "then": "同义枚举值合并到标准值",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "格式统一",
   "then": "日期与金额按统一格式",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "清洗留证",
   "then": "记录清洗规则与影响条数",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "先看分布",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "空串转空",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "枚举归一",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "格式统一",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "清洗留证",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}