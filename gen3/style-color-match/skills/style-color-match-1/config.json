{
 "rules": [
  {
   "when": "只看流行色",
   "then": "看肤色底调：冷调适合冷色，暖调适合暖色"
  },
  {
   "when": "全身黑白",
   "then": "安全但闷：加一个低饱和亮色"
  },
  {
   "when": "高饱和全身",
   "then": "降饱和：大面积用低饱和，亮色做点缀"
  },
  {
   "when": "不确定适合什么",
   "then": "试基础色：米白/藏蓝/灰最不容易错"
  }
 ],
 "keywords": [
  "显白",
