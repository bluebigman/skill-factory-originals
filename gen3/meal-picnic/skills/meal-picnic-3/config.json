{
 "rules": [
  {
   "when": "带需要保温的",
   "then": "带常温可放的：卤味/面包/水果/坚果"
  },
  {
   "when": "带易碎的",
   "then": "换容器：硬盒+分层"
  },
  {
   "when": "不带垃圾袋",
   "then": "必带：户外垃圾必须带走"
  },
  {
   "when": "不带水",
   "then": "带够水：户外脱水比饥饿更常见"
  }
 ],
 "keywords": [
  "野餐",
  "户外",
  "出门带",
  "带需要保温的",
  "带易碎的",
  "不带垃圾袋",
  "不带水"
 ],
