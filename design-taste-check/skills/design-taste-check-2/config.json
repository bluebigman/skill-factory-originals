{
 "name": "design-taste-check-2",
 "version": "2.0.0",
 "domain": "设计品味核查",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "原创性",
   "then": "检查是否套用通用模板",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "层级明确",
   "then": "视觉层级是否清晰",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "留白合理",
   "then": "避免拥挤",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "色彩克制",
   "then": "配色不超三色",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "细节一致",
   "then": "圆角间距风格统一",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "原创性",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "层级明确",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "留白合理",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "色彩克制",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "细节一致",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}