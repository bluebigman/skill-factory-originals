{
 "name": "agent-context-handoff-2",
 "version": "2.0.0",
 "domain": "上下文交",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "状态一致",
   "then": "交接后状态一致",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "可回溯",
   "then": "需时能回溯原文",
   "source": "scripts/main.py#RULES[1]"
  }
 ],
 "keywords": [
  {
   "term": "状态一致",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "可回溯",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [
  {
   "term": "理由",
   "source": "SKILL.md#L58"
  }
 ],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}