{
 "name": "semantic-layer-1",
 "version": "2.0.0",
 "domain": "语义层建设",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "业务术语映射",
   "then": "业务术语映射到物理字段",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "口径集中",
   "then": "口径集中管理",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "复用优先",
   "then": "新分析先查语义层",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "变更影响",
   "then": "变更评估影响",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "面向业务",
   "then": "面向业务人员可读",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "业务术语映射",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "口径集中",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "复用优先",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "变更影响",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "面向业务",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}