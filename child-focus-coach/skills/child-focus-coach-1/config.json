{
 "name": "child-focus-coach-1",
 "version": "2.0.0",
 "domain": "儿童专注力",
 "boundary": "本能力不提供心理或医学诊断；如涉及自伤、重度抑郁等，请转介专业机构。",
 "rules": [
  {
   "when": "时长匹配",
   "then": "按年龄（年龄×2-3 分钟）设定",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "不打断",
   "then": "孩子专注时不打扰",
   "source": "scripts/main.py#RULES[1]"
  }
 ],
 "keywords": [
  {
   "term": "时长匹配",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "不打断",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [
  {
   "term": "分钟",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "重度",
   "source": "SKILL.md#L78"
  },
  {
   "term": "提供心理",
   "source": "SKILL.md#L78"
  },
  {
   "term": "医学诊断",
   "source": "SKILL.md#L78"
  },
  {
   "term": "度抑郁等",
   "source": "SKILL.md#L78"
  },
  {
   "term": "介专业机",
   "source": "SKILL.md#L78"
  },
  {
   "term": "专业机构",
   "source": "SKILL.md#L78"
  },
  {
   "term": "自伤",
   "source": "SKILL.md#L78"
  }
 ],
 "features": [
  "cli",
  "selftest",
  "dry-run",
