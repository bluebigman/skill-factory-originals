{
 "name": "tech-review-coach-1",
 "version": "2.0.0",
 "domain": "技术方案",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "先讲约束",
   "then": "先说清现有约束（人力/时间/存量系统）",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "方案对比",
   "then": "至少给两个方案并说明取舍理由",
   "source": "scripts/main.py#RULES[1]"
  }
 ],
 "keywords": [
  {
   "term": "先讲约束",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "方案对比",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [
  {
   "term": "时间",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "至少",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "理由",
   "source": "scripts/main.py#RULES.then"
  }
 ],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}