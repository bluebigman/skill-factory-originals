{
 "name": "risk-boundary",
 "version": "2.0.0",
 "domain": "膳食搭配",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "快速减重",
   "then": "每周减重超体重 1% 不可持续，且易反弹",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "极端饮食",
   "then": "断食/极低碳需医师或营养师评估后执行",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "慢病",
   "then": "糖尿病/肾病/高血脂等必须遵医嘱方案，本工具不适用",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "孕期哺乳",
   "then": "此阶段营养需求特殊，务必遵医嘱",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "补充剂",
   "then": "补充剂不替代均衡膳食，剂量与禁忌须咨询专业人士",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
