{
 "name": "meal-prep",
 "version": "2.0.0",
 "domain": "膳食搭配",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "外卖偏多",
   "then": "外食按蒸煮烤优先，油炸类每周不超 2 次",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "时间不足",
   "then": "周末预处理蔬菜与主食分装，工作日仅组合",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "口味单调",
   "then": "用调味变化而非换食材维持多样性，醋/柠檬/香辛料零热量",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "食堂选择",
   "then": "按固定窗口建立白名单，现场决策最易选高油高糖",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "记录负担",
   "then": "只记结构与份数，不逐克称重，记录成本高必放弃",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
