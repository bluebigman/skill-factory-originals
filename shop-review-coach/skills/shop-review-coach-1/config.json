{
 "name": "shop-review-coach-1",
 "version": "2.0.0",
 "domain": "店铺数据",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "漏斗拆解",
   "then": "五层逐层看",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "点击低改主图",
   "then": "转化低查详情",
   "source": "scripts/main.py#RULES[1]"
  }
 ],
 "keywords": [
  {
   "term": "漏斗拆解",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "点击低改主图",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [
  {
   "term": "转化",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "详情",
   "source": "scripts/main.py#RULES.then"
  }
 ],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}