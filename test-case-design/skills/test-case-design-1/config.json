{
 "name": "test-case-design-1",
 "version": "2.0.0",
 "domain": "测试用例",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "先正常后异常",
   "then": "先设计正常路径，再补异常与边界",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "边界必测",
   "then": "空值、极值、超长、并发四项必测",
   "source": "scripts/main.py#RULES[1]"
  }
 ],
 "keywords": [
  {
   "term": "先正常后异常",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "边界必测",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [
  {
   "term": "助手",
   "source": "SKILL.md#L11"
  },
  {
   "term": "设计",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "再补",
   "source": "scripts/main.py#RULES.then"
  }
 ],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}