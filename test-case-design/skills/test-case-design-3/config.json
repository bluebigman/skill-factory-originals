{
 "name": "test-case-design-3",
 "version": "2.0.0",
 "domain": "测试用例",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "回归集",
   "then": "把历史线上问题沉淀为固定回归集",
   "source": "scripts/main.py#RULES[0]"
  }
 ],
 "keywords": [
  {
   "term": "回归集",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [
  {
   "term": "固定",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "助手",
   "source": "SKILL.md#L11"
  },
  {
   "term": "设计",
   "source": "SKILL.md#L57"
  },
  {
   "term": "历史",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "正常",
   "source": "SKILL.md#L3"
  },
  {
   "term": "再补",
   "source": "SKILL.md#L57"
  },
  {
   "term": "沉淀",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "线上",
   "source": "scripts/main.py#RULES.then"
  }
 ],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}