{
 "name": "lineage-impact-1",
 "version": "2.0.0",
 "domain": "血缘影响分析",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "变更前分析",
   "then": "结构变更前先做影响分析",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "下游清单",
   "then": "列出全部下游",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "通知机制",
   "then": "自动通知下游负责人",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "分级影响",
   "then": "按影响面分级",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "留痕",
   "then": "分析结论归档",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "变更前分析",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "下游清单",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "通知机制",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "分级影响",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "留痕",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}