{
 "name": "child-reading-coach-2",
 "version": "2.0.0",
 "domain": "儿童阅读",
 "boundary": "本能力不提供心理或医学诊断；如涉及自伤、重度抑郁等，请转介专业机构。",
 "rules": [
  {
   "when": "不考核",
   "then": "读完不问懂了没",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "家长同读",
   "then": "家长同步阅读并示范",
   "source": "scripts/main.py#RULES[1]"
  }
 ],
 "keywords": [
  {
   "term": "不考核",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "家长同读",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [
  {
   "term": "固定",
   "source": "SKILL.md#L3"
  },
  {
   "term": "分钟",
   "source": "SKILL.md#L57"
  },
  {
   "term": "重度",
   "source": "SKILL.md#L78"
  },
  {
   "term": "提供心理",
   "source": "SKILL.md#L78"
  },
  {
   "term": "医学诊断",
   "source": "SKILL.md#L78"
  },
  {
   "term": "度抑郁等",
   "source": "SKILL.md#L78"
  },
  {
   "term": "介专业机",
   "source": "SKILL.md#L78"
  },
  {
   "term": "专业机构",
   "source": "SKILL.md#L78"
  }
 ],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}