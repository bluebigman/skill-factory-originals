{
 "name": "meeting-minutes-pro-3",
 "version": "2.0.0",
 "domain": "会议纪要",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "决议明确",
   "then": "只记决议不记过程",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "责任人",
   "then": "每项待办必须有人",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "截止时间",
   "then": "必须带时间点",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "跟踪机制",
   "then": "待办纳入跟踪",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "共识标注",
   "then": "未达成共识的须标注",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "决议明确",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "责任人",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "截止时间",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "跟踪机制",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "共识标注",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}