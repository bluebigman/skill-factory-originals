{
 "name": "rag-pipeline-1",
 "version": "2.0.0",
 "domain": "检索增强流程",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "检索优先",
   "then": "先检索再生成",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "证据绑定",
   "then": "回答须绑定检索到的证据",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "无据不答",
   "then": "无证据时明确说没有",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "引用标注",
   "then": "标注引用来源",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "效果评测",
   "then": "建端到端评测集",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "检索优先",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "证据绑定",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "无据不答",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "引用标注",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "效果评测",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}