  },
  {
   "when": "条款明确",
   "then": "数据与知识产权归属写清",
   "source": "scripts/main.py#RULES[1]"
  }
 ],
 "keywords": [
  {
   "term": "先审资质",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "条款明确",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [
  {
   "term": "前先",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "写清",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "先核",
   "source": "scripts/main.py#RULES.then"
  }
 ],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
