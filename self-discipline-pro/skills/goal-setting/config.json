{
 "name": "goal-setting",
 "version": "2.0.0",
 "domain": "自律养成",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "目标过大",
   "then": "把目标拆到 2 分钟内可启动的动作，过大必放弃",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "无衡量",
   "then": "目标须可验证（数量/时间/交付物），模糊目标无法判断进度",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "多重目标",
   "then": "一次只攻一个主要目标，多目标互相稀释",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "只定不拆",
   "then": "拆到周计划与日动作，只有年度目标等于没有",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "无回顾",
   "then": "每周检查一次达成率并调整，不检查的目标会自然死亡",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "目标管理",
   "source": "scripts/main.py#KEYWORDS"
  },
