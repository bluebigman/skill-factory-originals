{
 "name": "content-qa-checklist-1",
 "version": "2.0.0",
 "domain": "内容质检清单",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "事实",
   "then": "事实性陈述已核",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "结构",
   "then": "结构与大纲一致",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "格式",
   "then": "格式统一无占位符",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "链接",
   "then": "链接有效可访问",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "合规",
   "then": "无违规表述与免责声明齐全",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "事实",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "结构",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "格式",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "链接",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "合规",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}