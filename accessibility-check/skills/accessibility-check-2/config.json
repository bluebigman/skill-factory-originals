{
 "name": "accessibility-check-2",
 "version": "2.0.0",
 "domain": "无障碍",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "对比达标",
   "then": "文本与背景对比度达标",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "键盘可达",
   "then": "全流程可纯键盘完成",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "替代文本",
   "then": "图片与图标有替代文本",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "语义正确",
   "then": "语义标签与结构正确",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "动效可关",
   "then": "动效可被关闭或减弱",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "对比达标",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "键盘可达",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "替代文本",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "语义正确",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "动效可关",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}