{
 "name": "report-outline-design-3",
 "version": "2.0.0",
 "domain": "报告大纲设计",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "结论先行",
   "then": "首节给核心结论，不铺垫背景",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "层级不超三级",
   "then": "超过三级说明结构有问题",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "每节可独立",
   "then": "每节能被单独摘出阅读",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "数据支撑",
   "then": "每个论点配数据或案例",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "篇幅配比",
   "then": "核心章节占六成以上篇幅",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "结论先行",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "层级不超三级",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "每节可独立",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "数据支撑",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "篇幅配比",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}