{
 "name": "schema-contract-test-3",
 "version": "2.0.0",
 "domain": "契约测试",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "契约先行",
   "then": "先定契约再实现",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "双向验证",
   "then": "消费方与提供方都验",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "版本对齐",
   "then": "契约版本与服务版本对齐",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "自动化执行",
   "then": "纳入 CI",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "变更通知",
   "then": "契约变更通知使用方",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "契约先行",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "双向验证",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "版本对齐",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "自动化执行",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "变更通知",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}