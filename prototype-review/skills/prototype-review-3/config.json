{
 "name": "prototype-review-3",
 "version": "2.0.0",
 "domain": "原型评审",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "不评美观",
   "then": "评审聚焦可用性，视觉美化单独一轮",
   "source": "scripts/main.py#RULES[0]"
  }
 ],
 "keywords": [
  {
   "term": "不评美观",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [
  {
   "term": "助手",
   "source": "SKILL.md#L11"
  },
  {
   "term": "流程",
   "source": "SKILL.md#L3"
  },
  {
   "term": "单独",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "角色",
   "source": "SKILL.md#L3"
  },
  {
   "term": "聚焦",
   "source": "scripts/main.py#RULES.then"
  }
 ],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}