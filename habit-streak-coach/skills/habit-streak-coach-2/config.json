{
 "name": "habit-streak-coach-2",
 "version": "2.0.0",
 "domain": "习惯打卡",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "固定触发",
   "then": "绑定在既有日常动作之后",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "可见记录",
   "then": "打卡记录放在看得见的地方",
   "source": "scripts/main.py#RULES[1]"
  }
 ],
 "keywords": [
  {
   "term": "固定触发",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "可见记录",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [
  {
   "term": "助手",
   "source": "SKILL.md#L11"
  },
  {
   "term": "版本",
   "source": "SKILL.md#L3"
  },
  {
   "term": "完成",
   "source": "SKILL.md#L57"
  },
  {
   "term": "允许",
   "source": "SKILL.md#L58"
  },
  {
   "term": "日常",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "最小",
   "source": "SKILL.md#L3"
  },
  {
   "term": "习惯",
   "source": "SKILL.md#L11"
  },
  {
   "term": "连续",
   "source": "SKILL.md#L11"
  }
 ],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}