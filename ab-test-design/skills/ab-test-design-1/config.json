{
 "name": "ab-test-design-1",
 "version": "2.0.0",
 "domain": "实验设计",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "单变量",
   "then": "一次只改一个变量，否则无法归因",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "先定主指标",
   "then": "实验前锁定唯一主指标与判定阈值",
   "source": "scripts/main.py#RULES[1]"
  }
 ],
 "keywords": [
  {
   "term": "单变量",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "先定主指标",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [
  {
   "term": "无法",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "设计",
   "source": "SKILL.md#L11"
  },
  {
   "term": "次只",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "定义",
   "source": "SKILL.md#L11"
  },
  {
   "term": "判定",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "则无",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "阈值",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "否则",
   "source": "scripts/main.py#RULES.then"
  }
 ],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}