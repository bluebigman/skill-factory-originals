{
 "name": "agent-data-boundary-1",
 "version": "2.0.0",
 "domain": "数据边界",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "最小采集",
   "then": "只采必要数据",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "范围控制",
   "then": "数据处理范围必须限定",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "去标识",
   "then": "能去标识的必须去",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "保留期限",
   "then": "明确数据保留期",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "删除机制",
   "then": "支持按需删除",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "最小采集",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "范围控制",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "去标识",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "保留期限",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "删除机制",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}