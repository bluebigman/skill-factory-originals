   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "影响",
   "source": "SKILL.md#L57"
  },
  {
   "term": "承诺",
   "source": "SKILL.md#L58"
  },
  {
   "term": "分层",
   "source": "SKILL.md#L3"
  },
  {
   "term": "定义",
   "source": "SKILL.md#L3"
  },
  {
   "term": "时限",
   "source": "SKILL.md#L11"
  },
  {
   "term": "度分",
   "source": "SKILL.md#L57"
  },
  {
   "term": "达成",
   "source": "scripts/main.py#RULES.then"
  }
 ],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
