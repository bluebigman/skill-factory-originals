{
 "name": "memory-layer-design-2",
 "version": "2.0.0",
 "domain": "记忆层设计",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "分层记忆",
   "then": "短期与长期分开",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "压缩策略",
   "then": "定期压缩历史",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "检索优先",
   "then": "按相关性检索回灌",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "冲突处理",
   "then": "新旧信息冲突取舍明确",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "隐私边界",
   "then": "明确可记忆范围",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "分层记忆",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "压缩策略",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "检索优先",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "冲突处理",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "隐私边界",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}