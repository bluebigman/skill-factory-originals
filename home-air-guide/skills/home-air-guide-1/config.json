  },
  {
   "when": "新家具",
   "then": "新家具前 3 个月加强通风",
   "source": "scripts/main.py#RULES[1]"
  }
 ],
 "keywords": [
  {
   "term": "定时通风",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "新家具",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [
  {
   "term": "分钟",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "助手",
   "source": "SKILL.md#L11"
  },
  {
   "term": "每日",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "每次",
   "source": "scripts/main.py#RULES.then"
  }
 ],
 "features": [
  "cli",
  "selftest",
