{
 "name": "meeting-sync-pro-2",
 "version": "2.0.0",
 "domain": "会议同步",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "纪要及时",
   "then": "会后限时出纪要",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "待办到人",
   "then": "待办必须有人有时间",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "分发明确",
   "then": "明确分发范围",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "追踪机制",
   "then": "待办纳入追踪",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "闭环确认",
   "then": "完成须确认",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "纪要及时",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "待办到人",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "分发明确",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "追踪机制",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "闭环确认",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}