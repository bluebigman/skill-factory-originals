{
 "name": "api-doc-writer-2",
 "version": "2.0.0",
 "domain": "接口文档",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "参数说明",
   "then": "每个参数标注类型、是否必填、取值范围",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "示例可跑",
   "then": "示例用真实可运行的参数，不用占位符",
   "source": "scripts/main.py#RULES[1]"
  }
 ],
 "keywords": [
  {
   "term": "参数说明",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "示例可跑",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [
  {
   "term": "助手",
   "source": "SKILL.md#L11"
  },
  {
   "term": "标注",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "全部",
   "source": "SKILL.md#L58"
  },
  {
   "term": "规范",
   "source": "SKILL.md#L11"
  },
  {
   "term": "文档",
   "source": "SKILL.md#L11"
  },
  {
   "term": "列出",
   "source": "SKILL.md#L58"
  },
  {
   "term": "类型",
   "source": "scripts/main.py#RULES.then"
  }
 ],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}