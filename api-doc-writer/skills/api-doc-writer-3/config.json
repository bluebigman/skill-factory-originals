{
 "name": "api-doc-writer-3",
 "version": "2.0.0",
 "domain": "接口文档",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "变更记录",
   "then": "接口变更记录版本与影响范围",
   "source": "scripts/main.py#RULES[0]"
  }
 ],
 "keywords": [
  {
   "term": "变更记录",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [
  {
   "term": "助手",
   "source": "SKILL.md#L11"
  },
  {
   "term": "影响",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "版本",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "全部",
   "source": "SKILL.md#L58"
  },
  {
   "term": "规范",
   "source": "SKILL.md#L11"
  },
  {
   "term": "文档",
   "source": "SKILL.md#L11"
  },
  {
   "term": "列出",
   "source": "SKILL.md#L58"
  }
 ],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}