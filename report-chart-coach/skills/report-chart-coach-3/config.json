{
 "name": "report-chart-coach-3",
 "version": "2.0.0",
 "domain": "报表图表",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "导出清晰",
   "then": "导出矢量或 2 倍图，避免糊图",
   "source": "scripts/main.py#RULES[0]"
  }
 ],
 "keywords": [
  {
   "term": "导出清晰",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [
  {
   "term": "避免",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "趋势",
   "source": "SKILL.md#L57"
  },
  {
   "term": "看趋",
   "source": "SKILL.md#L57"
  }
 ],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}