{
 "name": "plan",
 "version": "2.0.0",
 "domain": "活动方案",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "无时间轴",
   "then": "明确预热/开售/收尾三段的时间点与动作",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "无分工",
   "then": "每项动作指定责任人与完成时限",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "无物料",
   "then": "提前准备主图/详情/话术/客服预案，临场做必出错",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "无预案",
   "then": "准备爆单与冷场两套预案，无预案临场必乱",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "无公示",
   "then": "活动规则须提前公示，事后解释无效",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
