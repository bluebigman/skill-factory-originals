{
 "name": "itinerary",
 "version": "2.0.0",
 "domain": "旅游攻略",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "行程过满",
   "then": "每天主项目不超 2 个，赶场式行程没有体验",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "动线混乱",
   "then": "按地理位置聚类安排，来回折返浪费大量时间",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "无缓冲",
   "then": "每日预留 2 小时弹性，交通延误是旅行常态",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "体力透支",
   "then": "连续高强度后必须插入休整日",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "备选方案",
   "then": "每个必去点准备一个替代点，遇闭馆可即时替换",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
