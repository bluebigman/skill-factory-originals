{
 "name": "release-checklist-3",
 "version": "2.0.0",
 "domain": "发布清单",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "复盘留档",
   "then": "发布结果与异常记录留档",
   "source": "scripts/main.py#RULES[0]"
  }
 ],
 "keywords": [
  {
   "term": "复盘留档",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [
  {
   "term": "方案",
   "source": "SKILL.md#L58"
  },
  {
   "term": "写成",
   "source": "SKILL.md#L57"
  },
  {
   "term": "每次",
   "source": "SKILL.md#L58"
  },
  {
   "term": "发布",
   "source": "scripts/main.py#RULES.then"
  }
 ],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}