{
 "name": "content-repurpose-1",
 "version": "2.0.0",
 "domain": "内容复用",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "先定母题",
   "then": "先定核心观点再改形态",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "按平台适配",
   "then": "按平台特性调整形态",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "拒绝搬运",
   "then": "避免跨平台直接搬运",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "统一识别",
   "then": "保留统一品牌识别元素",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "对比效果",
   "then": "对比各形态的实际表现",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "先定母题",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "按平台适配",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "拒绝搬运",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "统一识别",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "对比效果",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}