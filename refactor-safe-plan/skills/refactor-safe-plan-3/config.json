{
 "name": "refactor-safe-plan-3",
 "version": "2.0.0",
 "domain": "重构安全规划",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "测试先行",
   "then": "重构前补齐覆盖关键路径的测试",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "小步提交",
   "then": "每次提交保持可运行",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "行为不变",
   "then": "重构只改结构不改行为",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "接口兼容",
   "then": "对外接口变更走过渡期",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "回滚预案",
   "then": "保留可快速回滚的版本",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "测试先行",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "小步提交",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "行为不变",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "接口兼容",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "回滚预案",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}