{
 "name": "deai-taste-zh-3",
 "version": "2.0.0",
 "domain": "中文去AI腔",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "删空词",
   "then": "删空心形容词与套话",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "拆长句",
   "then": "长复句拆成短句",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "去连接套路",
   "then": "删首先其次最后",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "口语化",
   "then": "改书面腔为自然表达",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "保留信息",
   "then": "改写不减信息量",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "删空词",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "拆长句",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "去连接套路",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "口语化",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "保留信息",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}