{
 "name": "agent-capability-declare-3",
 "version": "2.0.0",
 "domain": "能力声明",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "能做什么",
   "then": "显式列出能力清单",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "不能做什么",
   "then": "显式列出能力边界",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "输入要求",
   "then": "说明输入格式",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "输出形态",
   "then": "说明输出结构",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "失败模式",
   "then": "说明常见失败",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "能做什么",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "不能做什么",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "输入要求",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "输出形态",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "失败模式",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}