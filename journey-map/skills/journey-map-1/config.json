{
 "name": "journey-map-1",
 "version": "2.0.0",
 "domain": "用户旅程地图",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "阶段划分",
   "then": "按用户阶段划分",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "触点明确",
   "then": "标注全部触点",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "情绪曲线",
   "then": "标注情绪高低点",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "痛点定位",
   "then": "定位关键痛点",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "机会点",
   "then": "标注改进机会",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "阶段划分",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "触点明确",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "情绪曲线",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "痛点定位",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "机会点",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}