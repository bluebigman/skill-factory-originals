{
 "name": "incident-postmortem-2",
 "version": "2.0.0",
 "domain": "故障复盘",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "对事不对人",
   "then": "复盘指向机制不指向个人",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "时间线还原",
   "then": "按分钟还原事件与动作",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "根因分层",
   "then": "区分直接原因与系统性原因",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "改进项明确",
   "then": "每项有责任人与期限",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "闭环跟踪",
   "then": "改进项纳入常规跟踪",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "对事不对人",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "时间线还原",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "根因分层",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "改进项明确",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "闭环跟踪",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}