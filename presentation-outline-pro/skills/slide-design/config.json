{
 "name": "slide-design",
 "version": "2.0.0",
 "domain": "演示大纲",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "文字过多",
   "then": "每页正文不超过 6 行，讲稿放备注不入页面",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "图示混乱",
   "then": "图先于字：能用图说明就不写文字",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "配色刺眼",
   "then": "全篇配色不超三色，且保证投影环境可读",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "字号过小",
   "then": "正文字号不低于 18pt，投影会缩小视觉尺寸",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "对齐随意",
   "then": "统一左对齐与边距，对齐是最低成本的质感提升",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
