{
 "name": "endpoint-hardening-1",
 "version": "2.0.0",
 "domain": "终端加固",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "基线配置",
   "then": "按基线配置终端",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "最小软件",
   "then": "只装必要软件",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "自动更新",
   "then": "开启自动更新",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "磁盘加密",
   "then": "启用磁盘加密",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "定期核查",
   "then": "定期核查合规",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "基线配置",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "最小软件",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "自动更新",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "磁盘加密",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "定期核查",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}