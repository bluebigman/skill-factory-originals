{
 "name": "proofread-pro-1",
 "version": "2.0.0",
 "domain": "校对审阅",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "分层校对",
   "then": "先结构后文字",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "术语一致",
   "then": "全文术语统一",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "数字核对",
   "then": "关键数字须核对",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "格式统一",
   "then": "排版格式统一",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "交叉引用",
   "then": "引用须可跳转",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "分层校对",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "术语一致",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "数字核对",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "格式统一",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "交叉引用",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}