{
 "name": "dir-archive-rule-1",
 "version": "2.0.0",
 "domain": "目录归档",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "三层上限",
   "then": "目录层级不超三层",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "单一归属",
   "then": "一个文件只归一处，重复靠检索",
   "source": "scripts/main.py#RULES[1]"
  }
 ],
 "keywords": [
  {
   "term": "三层上限",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "单一归属",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [
  {
   "term": "助手",
   "source": "SKILL.md#L11"
  },
  {
   "term": "规范",
   "source": "SKILL.md#L11"
  },
  {
   "term": "命名",
   "source": "SKILL.md#L11"
  },
  {
   "term": "归档",
   "source": "SKILL.md#L11"
  },
  {
   "term": "层级",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "超三",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "检索",
   "source": "scripts/main.py#RULES.then"
  }
 ],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}