{
 "name": "teen-time-coach-2",
 "version": "2.0.0",
 "domain": "青少年",
 "boundary": "本能力不提供心理或医学诊断；如涉及自伤、重度抑郁等，请转介专业机构。",
 "rules": [
  {
   "when": "留白",
   "then": "日程留 20% 空白",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "只抓关键",
   "then": "每天 3 件必做",
   "source": "scripts/main.py#RULES[1]"
  }
 ],
 "keywords": [
  {
   "term": "留白",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "只抓关键",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [
  {
   "term": "时间",
   "source": "SKILL.md#L11"
  },
  {
   "term": "重度",
   "source": "SKILL.md#L78"
  },
  {
   "term": "提供心理",
   "source": "SKILL.md#L78"
  },
  {
   "term": "医学诊断",
   "source": "SKILL.md#L78"
  },
  {
   "term": "度抑郁等",
   "source": "SKILL.md#L78"
  },
  {
   "term": "介专业机",
   "source": "SKILL.md#L78"
  },
  {
   "term": "专业机构",
   "source": "SKILL.md#L78"
  },
  {
   "term": "自伤",
   "source": "SKILL.md#L78"
  }
 ],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}