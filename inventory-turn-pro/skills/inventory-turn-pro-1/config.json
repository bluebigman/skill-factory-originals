{
 "name": "inventory-turn-pro-1",
 "version": "2.0.0",
 "domain": "库存周转",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "ABC 分类",
   "then": "按金额与频次分类，管理力度差异化",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "安全库存",
   "then": "按交期波动定安全库存，不按感觉",
   "source": "scripts/main.py#RULES[1]"
  }
 ],
 "keywords": [
  {
   "term": "ABC 分类",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "安全库存",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [
  {
   "term": "管理",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "差异",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "清理",
   "source": "SKILL.md#L11"
  },
  {
   "term": "波动",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "感觉",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "频次",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "异化",
   "source": "scripts/main.py#RULES.then"
  }
 ],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}