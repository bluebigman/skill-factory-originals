{
 "name": "doc-index-rebuild-1",
 "version": "2.0.0",
 "domain": "文档索引重建",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "覆盖完整",
   "then": "覆盖全部关键概念",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "层级合理",
   "then": "主项子项分明",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "页码准确",
   "then": "生成后抽查",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "同义互指",
   "then": "别称指向主项",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "变更同步",
   "then": "正文改动后重建",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "覆盖完整",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "层级合理",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "页码准确",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "同义互指",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "变更同步",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}