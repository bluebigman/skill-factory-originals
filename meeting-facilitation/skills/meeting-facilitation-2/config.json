{
 "name": "meeting-facilitation-2",
 "version": "2.0.0",
 "domain": "会议主持",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "议程先行",
   "then": "会前发议程",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "时间盒",
   "then": "每项限时",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "结论明确",
   "then": "每项给结论",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "待办到人",
   "then": "行动项到人到期限",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "会后纪要",
   "then": "限时发纪要",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "议程先行",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "时间盒",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "结论明确",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "待办到人",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "会后纪要",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}