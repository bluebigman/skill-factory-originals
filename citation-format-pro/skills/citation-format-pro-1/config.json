{
 "name": "citation-format-pro-1",
 "version": "2.0.0",
 "domain": "引用规范",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "来源可查",
   "then": "每条引用可溯源",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "格式统一",
   "then": "全篇引用格式一致",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "页码明确",
   "then": "引用须给到具体位置",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "时效标注",
   "then": "引用须标时间",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "禁编造",
   "then": "无法核实的引用必须删除",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "来源可查",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "格式统一",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "页码明确",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "时效标注",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "禁编造",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}