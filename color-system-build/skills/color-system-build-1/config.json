{
 "name": "color-system-build-1",
 "version": "2.0.0",
 "domain": "配色系统构建",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "主色唯一",
   "then": "主色只有一个",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "语义色",
   "then": "成功警告错误各一色",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "对比达标",
   "then": "文字与背景对比达标",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "色盲友好",
   "then": "不单靠颜色区分",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "暗色适配",
   "then": "提供暗色版本",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "主色唯一",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "语义色",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "对比达标",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "色盲友好",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "暗色适配",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}