{
 "name": "log-troubleshoot-1",
 "version": "2.0.0",
 "domain": "日志排查",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "先定时间窗",
   "then": "先锁定问题发生的时间范围再翻日志",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "找首个异常",
   "then": "从第一个异常往下看，别从报错最密集处",
   "source": "scripts/main.py#RULES[1]"
  }
 ],
 "keywords": [
  {
   "term": "先定时间窗",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "找首个异常",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [
  {
   "term": "排查",
   "source": "SKILL.md#L11"
  },
  {
   "term": "报错",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "日志",
   "source": "scripts/main.py#RULES.then"
  }
 ],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}