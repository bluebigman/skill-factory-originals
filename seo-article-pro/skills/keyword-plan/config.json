{
 "name": "keyword-plan",
 "version": "2.0.0",
 "domain": "搜索排名",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "选词错位",
   "then": "先判搜索意图（信息/导航/交易），错位内容拿不到排名",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "密度堆砌",
   "then": "关键词自然出现即可，堆砌会被判定作弊",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "无长尾",
   "then": "主词竞争大，长尾词更容易获取初始流量",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "布局缺失",
   "then": "标题/首段/小标题/结尾各布局一次，仅正文出现权重低",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "同义词",
   "then": "覆盖同义与近义表达，提升语义匹配度",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
