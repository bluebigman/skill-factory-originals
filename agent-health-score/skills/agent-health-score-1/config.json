{
 "name": "agent-health-score-1",
 "version": "2.0.0",
 "domain": "健康评分",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "维度明确",
   "then": "评分维度须明确",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "权重公开",
   "then": "权重计算规则公开",
   "source": "scripts/main.py#RULES[1]"
  }
 ],
 "keywords": [
  {
   "term": "维度明确",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "权重公开",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [
  {
   "term": "健康",
   "source": "SKILL.md#L11"
  }
 ],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}