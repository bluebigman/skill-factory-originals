{
 "name": "landing-page-review-1",
 "version": "2.0.0",
 "domain": "落地页",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "首屏给结论",
   "then": "首屏必须让访客知道「能得到什么」",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "单一路径",
   "then": "主转化动作只保留一个，减少分叉",
   "source": "scripts/main.py#RULES[1]"
  }
 ],
 "keywords": [
  {
   "term": "首屏给结论",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "单一路径",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [
  {
   "term": "转化",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "减少",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "知道",
   "source": "scripts/main.py#RULES.then"
  }
 ],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}