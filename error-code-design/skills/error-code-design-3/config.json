{
 "name": "error-code-design-3",
 "version": "2.0.0",
 "domain": "错误码体系",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "分层编码",
   "then": "按模块与类别分段",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "含义稳定",
   "then": "同一码语义不随版本变",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "可操作",
   "then": "附处置建议而非仅描述",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "文档同步",
   "then": "错误码表与实现同步更新",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "对外收敛",
   "then": "对外暴露粗粒度码防信息泄露",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "分层编码",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "含义稳定",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "可操作",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "文档同步",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "对外收敛",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}