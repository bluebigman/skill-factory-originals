   "source": "SKILL.md#L11"
  },
  {
   "term": "缓冲",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "周期",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "预警",
   "source": "SKILL.md#L11"
  },
  {
   "term": "波动",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "日均",
   "source": "scripts/main.py#RULES.then"
  }
 ],
 "features": [
  "cli",
  "selftest",
