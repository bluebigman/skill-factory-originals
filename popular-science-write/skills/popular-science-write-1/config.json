{
 "name": "popular-science-write-1",
 "version": "2.0.0",
 "domain": "科普写作",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "先定读者",
   "then": "先确定读者已有知识水平",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "类比要准",
   "then": "类比只解释直觉，不替代准确表述",
   "source": "scripts/main.py#RULES[1]"
  }
 ],
 "keywords": [
  {
   "term": "先定读者",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "类比要准",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [
  {
   "term": "替代",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "教练",
   "source": "SKILL.md#L11"
  },
  {
   "term": "表达",
   "source": "SKILL.md#L11"
  },
  {
   "term": "确定",
   "source": "scripts/main.py#RULES.then"
  },
  {
   "term": "水平",
   "source": "scripts/main.py#RULES.then"
  }
 ],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}