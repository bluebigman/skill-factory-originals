{
 "name": "doc-collab-permission-2",
 "version": "2.0.0",
 "domain": "文档权限配置",
 "boundary": "本能力提供通用方法性建议，不构成专业诊断、治疗、法律或投资意见。",
 "rules": [
  {
   "when": "最小权限",
   "then": "按需给读写权限",
   "source": "scripts/main.py#RULES[0]"
  },
  {
   "when": "分级管理",
   "then": "按密级分层",
   "source": "scripts/main.py#RULES[1]"
  },
  {
   "when": "外发审批",
   "then": "外发须审批",
   "source": "scripts/main.py#RULES[2]"
  },
  {
   "when": "定期复核",
   "then": "定期清理失效权限",
   "source": "scripts/main.py#RULES[3]"
  },
  {
   "when": "变更留痕",
   "then": "权限变更记录",
   "source": "scripts/main.py#RULES[4]"
  }
 ],
 "keywords": [
  {
   "term": "最小权限",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "分级管理",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "外发审批",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "定期复核",
   "source": "scripts/main.py#KEYWORDS"
  },
  {
   "term": "变更留痕",
   "source": "scripts/main.py#KEYWORDS"
  }
 ],
 "recall_terms": [],
 "features": [
  "cli",
  "selftest",
  "dry-run",
  "error-handling",
  "json-output",
  "term-recall",
  "confidence",
  "clarify",
  "idempotent-cache"
 ],
 "encoding_fallback": [
  "utf-8",
  "gbk",
  "gb18030"
 ]
}